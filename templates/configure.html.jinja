            // Improved import scripts with detailed feedback.
            document.addEventListener("DOMContentLoaded", () => {

                function createStyledMessage(message, type = 'info') {
                    const div = document.createElement('div');
                    div.className = `status-message status-${type}`;
                    div.textContent = message;
                    return div;
                }

                function displayMessage(container, message, type = 'info') {
                    // CSS classes and icons by type.
                    const types = {
                        success: { class: 'bg-green-100 text-green-800 border-green-300', icon: 'fa-check-circle' },
                        error: { class: 'bg-red-100 text-red-800 border-red-300', icon: 'fa-exclamation-circle' },
                        warning: { class: 'bg-yellow-100 text-yellow-800 border-yellow-300', icon: 'fa-exclamation-triangle' },
                        info: { class: 'bg-blue-100 text-blue-800 border-blue-300', icon: 'fa-info-circle' },
                        progress: { class: 'bg-indigo-100 text-indigo-800 border-indigo-300', icon: 'fa-arrow-circle-right' }
                    };

                    const config = types[type] || types.info;

                    // Message with icon.
                    const messageElement = document.createElement('div');
                    messageElement.className = `p-2 mb-1 rounded border shadow-sm flex items-center ${config.class}`;
                    messageElement.innerHTML = `
						<i class="fas ${config.icon} mr-2 text-sm"></i>
						<span>${message}</span>
				`;

                    container.appendChild(messageElement);

                    // Limit to 10 lines (unchanged).
                    const maxLines = 10;
                    while (container.children.length > maxLines) {
                        container.removeChild(container.firstChild);
                    }

                    container.scrollTop = container.scrollHeight;
                }

                // --- Favorites management (placed here to ensure the DOM has loaded) ---
                document.querySelectorAll('.favorite-btn').forEach(button => {
                    button.addEventListener('click', async (event) => {
                        const btn = event.currentTarget;
                        const photo = btn.dataset.photo;

                        btn.disabled = true; // Empêcher les clics multiples

                        try {
                            const result = await photoEditor.favorite(photo);
                            if (result.success) {
                                // Update all corresponding buttons (one in the preview, one in favorites).
                                document.querySelectorAll(`.favorite-btn[data-photo="${photo}"]`).forEach(b => {
                                    b.classList.toggle('text-yellow-400', result.is_favorite);
                                    b.classList.toggle('text-gray-400', !result.is_favorite);
                                });

                                // --- Dynamic update logic ---
                                const favoritesBadge = document.getElementById('favorites-count-badge');
                                let count = parseInt(favoritesBadge.textContent, 10) || 0;

                                if (result.is_favorite) {
                                    count++;
                                } else {
                                    count = Math.max(0, count - 1);
                                    const tileToRemove = document.querySelector(`#tab-favoris .photo-tile[data-path="${photo}"]`);
                                    if (tileToRemove) tileToRemove.remove();
