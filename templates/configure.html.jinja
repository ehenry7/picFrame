            async function refreshValidationTab() {
                const grid = document.getElementById('pending-photos-grid');
                const badge = document.getElementById('pending-count-badge');
                const interactionsBadge = document.getElementById('interactions-pending-badge');
                const validationTab = document.getElementById('tab-validation');
                const isTabActive = validationTab && validationTab.style.display === 'block';

                try {
                    const response = await fetch(`/api/get_pending_photos?_=${new Date().getTime()}`);
                    const data = await response.json();

                    if (!data.success) {
                        console.error("Erreur récupération photos en attente:", data.message);
                        return;
                    }

                    const photoCount = data.photos.length;

                    // Update the badge.
                    [badge, interactionsBadge].forEach(el => {
                        if (el) {
                            el.textContent = photoCount;
                            if (photoCount > 0) {
                                el.classList.remove('hidden');
                            } else {
                                el.classList.add('hidden');
                            }
                        }
                    });

                    // Update the grid.
                    if (isTabActive && grid) {
                        if (photoCount === 0) {
                            grid.innerHTML = '<p class="text-center text-gray-500 italic">{{ _("No photos awaiting validation.") }}</p>';
