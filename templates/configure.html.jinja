<!DOCTYPE html>
{% macro date_format_help() %}
<details class="text-xs text-gray-600 mt-2">
    <summary class="cursor-pointer">{{ _("Date format reference") }}</summary>
    <p class="mt-1">{{ _("Combine these codes with spaces or punctuation. Month and weekday names follow the slideshow's system locale.") }}</p>
    <ul class="list-disc ml-5 mt-1">
        <li><code>%Y</code> — {{ _("Four-digit year") }} (2026); <code>%y</code> — {{ _("Two-digit year") }} (26)</li>
        <li><code>%m</code> — {{ _("Month number") }} (01–12); <code>%d</code> — {{ _("Day of month") }} (01–31)</li>
        <li><code>%B</code> / <code>%b</code> — {{ _("Full / abbreviated month name") }}</li>
        <li><code>%A</code> / <code>%a</code> — {{ _("Full / abbreviated weekday name") }}</li>
        <li><code>%H</code> / <code>%I</code> — {{ _("Hour (24-hour / 12-hour)") }}; <code>%p</code> — AM/PM</li>
        <li><code>%M</code> / <code>%S</code> — {{ _("Minute / second") }}; <code>%%</code> — %</li>
    </ul>
    <p class="mt-1">{{ _("Examples (15 June 2020):") }}</p>
    <ul class="list-disc ml-5">
        <li><code>%Y</code> → 2020</li>
        <li><code>%d/%m/%Y</code> → 15/06/2020</li>
        <li><code>%m/%d/%Y</code> → 06/15/2020</li>
        <li><code>%Y-%m-%d</code> → 2020-06-15</li>
        <li><code>%d %B %Y</code> → 15 June 2020</li>
        <li><code>%B %Y</code> → June 2020</li>
    </ul>
</details>
{% endmacro %}
{% macro extra_filter_options(active_filter) %}
{% for value, label in [
    ('auto_enhance', _('Auto Enhance')),
    ('vivid', _('Vivid')),
    ('warm', _('Warm')),
    ('cool', _('Cool')),
    ('dramatic_bw', _('Dramatic B&W')),
    ('soft_glow', _('Soft Glow')),
    ('sharpen', _('Sharpen')),
    ('duotone', _('Duotone')),
    ('posterize', _('Posterize')),
    ('matte', _('Matte')),
    ('film_grain', _('Film Grain')),
    ('pencil_sketch', _('Pencil Sketch')),
    ('selective_red', _('Selective Color - Red')),
    ('selective_green', _('Selective Color - Green')),
    ('selective_blue', _('Selective Color - Blue')),
    ('tilt_shift', _('Tilt Shift')),
    ('cinematic', _('Cinematic')),
    ('cross_process', _('Cross Process')),
    ('watercolor', _('Watercolor')),
    ('dark_vignette', _('Vignette - Dark Edges'))
] %}
<option value="{{ value }}" {% if active_filter == value %}selected{% endif %}>{{ label }}</option>
{% endfor %}
{% endmacro %}
<html lang="{{ get_locale() }}" dir="{{ 'rtl' if get_locale() == 'he' else 'ltr' }}">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ _('Configuration') }} - PictureFrame</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link rel="stylesheet" href="{{ url_for('static', filename='styles.css') }}">
    <link rel="icon" type="image/x-icon" href="{{ url_for('static', filename='favicon.ico') }}">
    <!-- GLightbox CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/glightbox/dist/css/glightbox.min.css" />
    <!-- Font Awesome icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <!-- Chart.js charts -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        /* Improve tab scrolling on mobile */
        .tabs::-webkit-scrollbar {
            display: none;
            /* Chrome, Safari, Opera */
        }

        .tabs {
            -ms-overflow-style: none;
            /* IE et Edge */
            scrollbar-width: none;
            /* Firefox */
        }

        /* Styles for action groups and progress bars */
        .action-group {
            margin-bottom: 20px;
        }

        .action-group h4 {
            font-size: 1.2em;
            margin-bottom: 10px;
            color: #555;
        }

        .import-button,
        .system-button {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .progress-container {
            width: 100%;
            background-color: #f3f4f6;
            border-radius: 0.5rem;
            margin-top: 0.75rem;
            height: 1.5rem;
            overflow: hidden;
            box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.1);
            border: 1px solid #d1d5db;
        }

        .progress-bar {
            height: 100%;
            text-align: center;
            white-space: nowrap;
            transition: width 0.3s ease;
            color: white;
            font-weight: 500;
            background-image: linear-gradient(90deg, #a855f7, #6366f1);
            box-shadow: 0 0 5px rgba(107, 114, 142, 0.5);
        }

        /* Styles for the new group navigation */
        .main-nav-link {
            padding: 0.75rem 1.5rem;
            cursor: pointer;
            font-weight: 500;
            background-color: #E06666;
            /* Pastel red background inspired by the logo */
            color: #FFFFFF;
            /* White text for contrast */
            border-radius: 0.375rem;
            /* rounded-md */
            transition: all 0.2s ease-in-out;
            border: 1px solid transparent;
            /* Prevent layout shifts on hover/click */
        }

        .main-nav-link:hover {
            background-color: #E5E7EB;
            /* gray-200 */
            color: #1F2937;
            /* gray-800 */
        }

        .main-nav-link.active {
            background-color: white;
            color: #005a9e;
            /* A more subtle, darker blue */
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06);
            /* shadow-sm */
            border-color: #D1D5DB;
            /* gray-300 */
        }

        /* Pulse animation for the play button */
        @keyframes pulse-ring {
            0% {
                box-shadow: 0 0 0 0 rgba(37, 99, 235, 0.7);
            }

            70% {
                box-shadow: 0 0 0 10px rgba(37, 99, 235, 0);
            }

            100% {
                box-shadow: 0 0 0 0 rgba(37, 99, 235, 0);
            }
        }

        .pulse-animation {
            animation: pulse-ring 2s infinite;
        }
    </style>
</head>

<body class="relative min-h-screen">

    <!-- Global Notification Toast -->
    <div id="global-toast"
        class="hidden fixed bottom-5 right-5 bg-green-600 text-white py-2 px-4 rounded-lg shadow-lg transition-all duration-300 ease-in-out transform translate-y-10 opacity-0 z-50">
        <p id="global-toast-message"></p>
    </div>

    <!-- Flash messages -->
    {% with messages = get_flashed_messages(with_categories=true) %}
    {% if messages %}
    <div id="flash-container" class="relative z-10 max-w-xl mx-auto mt-4 space-y-2">
        {% for category, message in messages %}
        <div class="
          flash-message
          px-4 py-3 rounded-md text-white shadow-md transition-opacity duration-700 ease-in-out
          {% if category == 'success' %}
            bg-green-500
          {% elif category == 'error' %}
            bg-red-500
          {% elif category == 'warning' %}
            bg-yellow-400 text-black
          {% else %}
            bg-gray-500
          {% endif %}
        ">
            {{ message }}
        </div>
        {% endfor %}
    </div>

    <script>
        // Automatically hide after 4 seconds.
        setTimeout(() => {
            const messages = document.querySelectorAll('.flash-message');
            messages.forEach(msg => {
                msg.classList.add('opacity-0');
                setTimeout(() => msg.remove(), 700); // attendre que l'effet se termine
            });
        }, 4000);
    </script>
    {% endif %}
    {% endwith %}

    <script>
        // --- Run mode switcher (picture frame / background updater) ---
        // NOTE: This script must live OUTSIDE the flash-messages conditional
        // block; otherwise it is only emitted when there are flash messages
        // to display, and the Apply button never fires.
        document.addEventListener('DOMContentLoaded', function () {
            const applyBtn = document.getElementById('apply-mode-btn');
            const statusSpan = document.getElementById('app-mode-status');
            const settingsBox = document.getElementById('background-settings');
            const modeRadios = document.querySelectorAll('input[name="app_mode_radio"]');
            // The mode currently persisted on the server (rendered in the
            // template).  Used to detect whether the user actually changed
            // the selection before prompting.
            const persistedMode = '{{ config.get("app_mode", "picture_frame") }}';

            function currentModeChoice() {
                const checked = document.querySelector('input[name="app_mode_radio"]:checked');
                return checked ? checked.value : null;
            }

            // Live highlight: move the indigo border/bg to whichever radio
            // is currently selected, before and after saving.
            function updateRadioHighlight() {
                const selected = currentModeChoice();
                modeRadios.forEach(function (radio) {
                    var label = radio.closest('label');
                    if (!label) return;
                    if (radio.checked) {
                        label.classList.remove('bg-gray-50', 'border-gray-200');
                        label.classList.add('bg-indigo-50', 'border-indigo-400');
                    } else {
                        label.classList.remove('bg-indigo-50', 'border-indigo-400');
                        label.classList.add('bg-gray-50', 'border-gray-200');
                    }
                });
                // Show/hide the background-specific settings panel.
                if (settingsBox) {
                    settingsBox.classList.toggle('hidden', selected !== 'background_updater');
                }
                // Issue 4: the display-duration field is only relevant in
                // picture-frame mode; the background-update interval is only
                // relevant in background mode (it lives inside settingsBox).
                var pfDuration = document.getElementById('picture-frame-duration-fieldset');
                if (pfDuration) {
                    pfDuration.classList.toggle('hidden', selected === 'background_updater');
                }
            }

            modeRadios.forEach(function (radio) {
                radio.addEventListener('change', updateRadioHighlight);
            });

            if (applyBtn) {
                applyBtn.addEventListener('click', function () {
                    const newMode = currentModeChoice();
                    if (!newMode) return;

                    // Issue 2: ask the user to confirm before applying.
                    if (newMode !== persistedMode) {
                        var msg = (newMode === 'background_updater')
                            ? '{{ _("Switch to desktop background updater mode? The fullscreen slideshow window will be closed.") }}'
                            : '{{ _("Switch to picture frame mode? The desktop background will stop updating.") }}';
                        if (!window.confirm(msg)) {
                            return;
                        }
                    }

                    statusSpan.textContent = '';
                    fetch('/api/app_mode', {
                        method: 'POST',
                        headers: {'Content-Type': 'application/json'},
                        body: JSON.stringify({app_mode: newMode})
                    })
                    .then(function (response) { return response.json(); })
                    .then(function (data) {
                        if (data.success) {
                            statusSpan.textContent = data.app_mode === 'background_updater'
                                ? '{{ _("Background updater mode activated.") }}'
                                : '{{ _("Picture frame mode activated.") }}';
                            // Issue 3: the highlight is already correct from
                            // updateRadioHighlight(), but re-apply after reload
                            // so the persisted state is consistent.
                            setTimeout(function () { window.location.reload(); }, 800);
                        } else {
                            statusSpan.textContent = data.message || '{{ _("Mode switch failed.") }}';
                        }
                    })
                    .catch(function () {
                        statusSpan.textContent = '{{ _("Mode switch failed.") }}';
                    });
                });
            }

            // Initialise the highlight on load.
            updateRadioHighlight();
        });
    </script>

    <!-- Contenu principal -->
    <div class="relative z-10 container mx-auto p-4 bg-white/80 backdrop-blur-md rounded-xl shadow-xl mt-8">
        <div class="flex justify-between items-center mb-4">
            <div class="language-selector text-sm">
                <span class="font-semibold">{{ _('Language') }}:</span>
                {% set current_lang = get_locale() %}
                <a href="?lang=fr"
                    class="{% if current_lang == 'fr' %}font-bold text-indigo-600{% else %}text-blue-600 hover:underline{% endif %}">FR</a>
                |
                <a href="?lang=en"
                    class="{% if current_lang == 'en' %}font-bold text-indigo-600{% else %}text-blue-600 hover:underline{% endif %}">EN</a>
                |
                <a href="?lang=he"
                    class="{% if current_lang == 'he' %}font-bold text-indigo-600{% else %}text-blue-600 hover:underline{% endif %}">HE</a>
            </div>
            <div class="logout-link">
                <a href="/logout">{{ _('Disconnect') }}</a>
            </div>
        </div>
        <div class="flex justify-between items-center mb-2 h-auto py-2">
            <div class="flex flex-col items-start">
                <img src="{{ url_for('static', filename='pictureframe_logo.svg') }}" alt="Logo PictureFrame" class="h-16">
                <span class="text-xs text-gray-400 mt-1">v{{ APP_VERSION }}</span>
            </div>

            <div id="live-preview-container" class="cadre-bois p-4 flex flex-col items-center">
                <p id="live-preview-status" class="text-gray-500 italic hidden">{{ _("The slideshow is stopped.") }}</p>

                <div id="live-preview-box" class="relative mt-1 w-64 h-40 flex items-center justify-center bg-gray-100 rounded-lg shadow-inner overflow-hidden border border-gray-200 hidden">
                    <img id="live-preview-image" src="" alt="{{ _('Photo in progress') }}"
                        class="max-w-full max-h-full object-contain">

                    <!-- Control buttons always visible at the bottom of the image -->
                    <div id="live-preview-controls"
                        class="absolute bottom-2 left-0 right-0 flex items-center justify-center gap-3 hidden">
                        <button type="button"
                            class="notification-toggle-btn bg-blue-600 hover:bg-blue-700 text-white p-2 rounded-full w-8 h-8 flex items-center justify-center shadow-md transition-transform transform hover:scale-110"
                            title="{{ _('Enable/Disable notifications') }}">
                            <i class="fas fa-bell fa-xs"></i>
                        </button>
                        <button type="button"
                            class="slideshow-control-btn bg-blue-600 hover:bg-blue-700 text-white p-2 rounded-full w-8 h-8 flex items-center justify-center shadow-md transition-transform transform hover:scale-110"
                            data-command="previous" title="{{ _('Previous photo') }}">
                            <i class="fas fa-backward fa-xs"></i>
                        </button>
                        <button type="button"
                            class="slideshow-control-btn bg-blue-600 hover:bg-blue-700 text-white p-2 rounded-full w-8 h-8 flex items-center justify-center shadow-md transition-transform transform hover:scale-110"
                            data-command="toggle_pause" title="{{ _('Pause/Reading') }}">
                            <i class="slideshow-pause-icon fas fa-pause fa-xs"></i>
                        </button>
                        <button type="button"
                            class="slideshow-control-btn bg-blue-600 hover:bg-blue-700 text-white p-2 rounded-full w-8 h-8 flex items-center justify-center shadow-md transition-transform transform hover:scale-110"
                            data-command="next" title="{{ _('Next photo') }}">
                            <i class="fas fa-forward fa-xs"></i>
                        </button>
                    </div>
                </div>
                <p id="live-preview-metadata" class="hidden mt-2 w-64 truncate text-sm text-gray-600" dir="auto"></p>
                <p id="live-preview-location" class="hidden mt-1 w-64 truncate text-sm text-gray-600" dir="auto"></p>
            </div>
        </div>

        <!-- New group navigation -->
        <div id="main-nav" class="flex justify-center space-x-1 sm:space-x-2 p-1 bg-transparent rounded-lg mb-4">
            <button class="main-nav-link inline-flex items-center" data-group="group-diaporama"><i
                    class="fas fa-desktop fa-fw mr-2"></i>{{ _('Slideshow') }}</button>
            <button class="main-nav-link inline-flex items-center" data-group="group-contenu"><i
                    class="fas fa-photo-video fa-fw mr-2"></i>{{ _('Content') }}</button>
            <button class="main-nav-link inline-flex items-center" data-group="group-interactions"><i
                    class="fas fa-comments fa-fw mr-2"></i>{{ _('Interactions') }} <span id="interactions-pending-badge"
                    class="hidden bg-red-500 text-white text-xs font-bold rounded-full h-5 w-5 inline-flex items-center justify-center ml-1">0</span></button>
            <button class="main-nav-link inline-flex items-center" data-group="group-maintenance"><i
                    class="fas fa-server fa-fw mr-2"></i>{{ _('System') }}</button>
        </div>

        <!-- Sub-navigation containers for each group -->
        <div id="group-diaporama" class="sub-nav-group hidden">
            <div class="tabs flex overflow-x-auto pb-2">
                <button class="tablink inline-flex items-center" onclick="openTab(event, 'tab-affichage')"
                    title="{{ _('Gérez les paramètres d\'affichage du diaporama, la durée, les transitions...') }}"><i
                        class="fas fa-desktop fa-fw mr-2"></i>{{ _('Display') }}</button>
                <button class="tablink inline-flex items-center" onclick="openTab(event, 'tab-heure')"
                    title="{{ _('Configurez l\'affichage de l\'heure, la météo et les marées.') }}"><i
                        class="fas fa-clock fa-fw mr-2"></i>{{ _('Clock & Info') }}</button>
                <button class="tablink inline-flex items-center" onclick="openTab(event, 'tab-metadata')"><i
                        class="fas fa-info-circle fa-fw mr-2"></i>{{ _('Metadata') }}</button>
            </div>
        </div>

        <div id="group-contenu" class="sub-nav-group hidden">
            <div class="tabs flex overflow-x-auto pb-2">
                <button class="tablink inline-flex items-center" onclick="openTab(event, 'tab-sources')"
                    title="{{ _('Configure photo sources.') }}"><i
                        class="fas fa-folder-open fa-fw mr-2"></i>{{ _('Sources') }}</button>
                <button class="tablink inline-flex items-center" onclick="openTab(event, 'tab-apercu')"
                    title="{{ _('Visualize and manage all the photos ready for slideshow.') }}"><i
                        class="fas fa-eye fa-fw mr-2"></i>{{ _('Preview') }}</button>
                <button class="tablink inline-flex items-center" onclick="openTab(event, 'tab-playlists')"
                    title="{{ _('Create and manage your personalized photo albums.') }}"><i
                        class="fas fa-list-ul fa-fw mr-2"></i>{{ _('Playlists') }}</button>
                <button class="tablink inline-flex items-center" onclick="openTab(event, 'tab-favoris')"
                    title="{{ _('Find and manage your favorite photos.') }}"><i class="fas fa-star fa-fw mr-2"></i>{{
                    _('Favorites') }} <span id="favorites-count-badge"
                        class="hidden bg-yellow-400 text-white text-xs font-bold rounded-full h-5 w-5 inline-flex items-center justify-center ml-1">0</span></button>
            </div>
        </div>

        <div id="group-interactions" class="sub-nav-group hidden">
            <div class="tabs flex overflow-x-auto pb-2">
                <button class="tablink inline-flex items-center" onclick="openTab(event, 'tab-validation')"
                    title="{{ _('Validate or reject the photos sent by the guests.') }}"><i
                        class="fas fa-check-circle fa-fw mr-2"></i>{{ _('Validation') }} <span id="pending-count-badge"
                        class="hidden bg-red-500 text-white text-xs font-bold rounded-full h-5 w-5 inline-flex items-center justify-center ml-1">0</span></button>
                <button class="tablink inline-flex items-center" onclick="openTab(event, 'tab-actions')"
                    title="{{ _('Launch the imports, control the slideshow and send photos.') }}"><i
                        class="fas fa-cogs fa-fw mr-2"></i>{{ _('Actions') }}</button>
            </div>
        </div>

        <div id="group-maintenance" class="sub-nav-group hidden">
            <div class="tabs flex overflow-x-auto pb-2">
                <button class="tablink inline-flex items-center" onclick="openTab(event, 'tab-network')"
                    title="{{ _('Manage Wi-Fi and network settings.') }}"><i class="fas fa-wifi fa-fw mr-2"></i>{{
                    _('Network') }}</button>
                <button class="tablink inline-flex items-center" onclick="openTab(event, 'tab-maintenance')"
                    title="{{ _('Manage backups and system checks.') }}"><i
                        class="fas fa-tools fa-fw mr-2"></i>{{ _('Maintenance') }}</button>
                <button class="tablink inline-flex items-center" onclick="openTab(event, 'tab-stats')"
                    title="{{ _('Consultez les statistiques d\'utilisation du système.') }}"><i
                        class="fas fa-chart-bar fa-fw mr-2"></i>{{ _('Statistics') }}</button>
                <button class="tablink inline-flex items-center" onclick="openTab(event, 'tab-logs')"
                    title="{{ _('Check the system logs.') }}"><i class="fas fa-file-alt fa-fw mr-2"></i>{{
                    _('Logs') }}</button>
            </div>
        </div>

        <form method="POST" action="/configure">

            <div id="tab-affichage" class="tabcontent" style="display:block">
                <fieldset>
                    <legend>
                        <h3>{{ _("Run mode") }}</h3>
                    </legend>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <label class="p-3 border rounded cursor-pointer {% if config.get('app_mode', 'picture_frame') != 'background_updater' %}bg-indigo-50 border-indigo-400{% else %}bg-gray-50 border-gray-200{% endif %}">
                            <input type="radio" name="app_mode_radio" value="picture_frame"
                                {% if config.get('app_mode', 'picture_frame') != 'background_updater' %}checked{% endif %}>
                            <span class="font-semibold ml-2">{{ _("Picture frame") }}</span>
                            <p class="text-xs text-gray-500 mt-1">{{ _("Fullscreen slideshow on this device's screen (Raspberry Pi).") }}</p>
                        </label>
                        <label class="p-3 border rounded cursor-pointer {% if config.get('app_mode') == 'background_updater' %}bg-indigo-50 border-indigo-400{% else %}bg-gray-50 border-gray-200{% endif %}">
                            <input type="radio" name="app_mode_radio" value="background_updater"
                                {% if config.get('app_mode') == 'background_updater' %}checked{% endif %}>
                            <span class="font-semibold ml-2">{{ _("Desktop background updater") }}</span>
                            <p class="text-xs text-gray-500 mt-1">{{ _("Compose a photo with overlays and set it as the desktop wallpaper on all screens.") }}</p>
                        </label>
                    </div>

                    <div class="mt-3 flex items-center gap-3">
                        <button type="button" id="apply-mode-btn"
                                class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 px-4 rounded text-sm">{{ _("Apply mode") }}</button>
                        <span id="app-mode-status" class="text-sm"></span>
                    </div>

                    <div id="background-settings" class="mt-4 pt-4 border-t {% if config.get('app_mode') != 'background_updater' %}hidden{% endif %}">
                        <h4 class="font-semibold text-sm mb-2">{{ _("Background updater settings") }}</h4>

                        <label for="background_update_interval">{{ _("Background update interval (seconds) :") }}</label>
                        <input type="number" id="background_update_interval" name="background_update_interval" min="30"
                            value="{{ config.get('background_update_interval', 3600) }}">

                        <label for="background_output_format" class="block mt-3">{{ _("Background image format :") }}</label>
                        <select id="background_output_format" name="background_output_format">
                            <option value="png" {% if config.get('background_output_format', 'png') == 'png' %}selected{% endif %}>PNG</option>
                            <option value="jpg" {% if config.get('background_output_format') == 'jpg' %}selected{% endif %}>JPEG</option>
                        </select>

                        <label for="background_resolution_mode" class="block mt-3">{{ _("Background resolution :") }}</label>
                        <select id="background_resolution_mode" name="background_resolution_mode">
                            <option value="auto" {% if config.get('background_resolution_mode', 'auto') == 'auto' %}selected{% endif %}>{{ _("Automatic (largest screen)") }}</option>
                            <option value="manual" {% if config.get('background_resolution_mode') == 'manual' %}selected{% endif %}>{{ _("Manual (use target display size)") }}</option>
                        </select>

                        <label for="background_display_style" class="block mt-3">{{ _("Photo display mode :") }}</label>
                        <select id="background_display_style" name="background_display_style" class="w-full">
                            <option value="fill" {% if config.get('background_display_style', 'fit') == 'fill' %}selected{% endif %}>{{ _("Full screen (fill, crop if needed)") }}</option>
                            <option value="fit" {% if config.get('background_display_style', 'fit') == 'fit' %}selected{% endif %}>{{ _("Fit (whole photo, black bars)") }}</option>
                            <option value="stretch" {% if config.get('background_display_style', 'fit') == 'stretch' %}selected{% endif %}>{{ _("Stretched (fill, may distort)") }}</option>
                            <option value="span" {% if config.get('background_display_style', 'fit') == 'span' %}selected{% endif %}>{{ _("Span (fill across screens)") }}</option>
