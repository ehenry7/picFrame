                        <h5 class="text-lg font-semibold text-gray-900">${playlist.name}</h5>
                        <p class="text-sm text-gray-500" id="photo-count-${playlist.id}">${photoCountText}</p>
                    </div>
                    <div class="flex items-center gap-4">
                        <select class="playlist-music-select text-sm rounded-md border-gray-300 shadow-sm" data-playlist-id="${playlist.id}">
                            ${musicOptionsHtml}
                        </select>
                        <button type="button" class="play-music-btn bg-gray-200 hover:bg-gray-300 text-gray-800 font-bold w-10 h-10 flex items-center justify-center rounded text-sm" data-target-select-id="${playlist.id}" data-music-file="${playlist.music_file || ''}" ${playlist.music_file ? '' : 'disabled'} title="${i18n.listenToMusic}">
                            <i class="fas fa-play fa-fw"></i>
                        </button>
                        <button class="rename-playlist-btn text-gray-500 hover:text-blue-600" data-id="${playlist.id}" title="${i18n.renamePlaylist}">
                            <i class="fas fa-edit"></i>
                        </button>
                        <button class="start-playlist-btn bg-blue-500 hover:bg-blue-600 text-white text-sm font-semibold py-2 px-4 rounded inline-flex items-center" data-id="${playlist.id}">
                            <i class="fas fa-play mr-2"></i>${i18n.launch}
                        </button>
                        <button class="delete-playlist-btn text-red-500 hover:text-red-700" data-id="${playlist.id}" title="${i18n.deletePlaylist}">
                            <i class="fas fa-trash-alt"></i>
                        </button>
                        <i class="fas fa-chevron-down text-gray-400 playlist-chevron"></i>
                    </div>
                </div>
                <div id="photos-container-${playlist.id}" class="hidden mt-4 photo-grid border-t pt-4" data-playlist-id="${playlist.id}">
                    ${photosHtml}
                </div>
            `;
                        playlistsContainer.appendChild(playlistEl);
                    });

                    // Add event listeners for the music selectors.
                    document.querySelectorAll('.playlist-music-select').forEach(select => {
                        select.addEventListener('change', async (event) => {
                            const playlistId = event.target.dataset.playlistId;
                            const musicFile = event.target.value;
                            try {
                                const response = await fetch(`/api/playlists/${playlistId}/update_music`, {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({ music_file: musicFile })
                                });
                                const result = await response.json();
                                if (result.success) {
                                    showToast(i18n.musicUpdated);
                                } else {
                                    alert(`${i18n.errorPrefix} ${result.message}`);
