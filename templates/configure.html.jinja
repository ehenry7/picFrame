                // Function to retrieve and display logs.
                async function fetchLogs() {
                    const logSelector = document.getElementById('log-selector');
                    const logContentElement = document.getElementById('log-content');
                    // Handle the case where there are no logs to display.
                    if (logSelector.options.length === 0 || !logSelector.value) {
                        logContentElement.textContent = "{{ _('No log files available or selected.') }}";
                        return;
                    }

                    const logType = logSelector.value;
                    try {
                        const response = await fetch(`/api/logs?type=${logType}`);
                        const data = await response.json();
                        if (data.success) {
                            if (data.content && data.content.trim() !== '') {
                                logContentElement.textContent = data.content;
                            } else {
                                logContentElement.innerHTML = '&nbsp;';
                            }
                            logContentElement.parentElement.scrollTop = logContentElement.parentElement.scrollHeight;
                        } else {
                            logContentElement.textContent = `{{ _('Error:') }} ${data.message}`;
                        }
                    } catch (error) {
                        console.error("Erreur de communication avec l'API logs:", error);
                        logContentElement.textContent = "{{ _('Erreur de connexion à l\'API des logs.') }}";
                    }
                }

                // NEW: Dynamically load the list of log files.
                async function loadLogFiles() {
                    const logSelector = document.getElementById('log-selector');
                    logSelector.innerHTML = `<option>{{ _('Loading...') }}</option>`;
                    try {
                        const response = await fetch('/api/list_logs');
                        const data = await response.json();
                        logSelector.innerHTML = ''; // Vider
                        if (data.success && data.logs.length > 0) {
                            data.logs.forEach(log => {
                                const option = document.createElement('option');
                                option.value = log.key;
                                option.textContent = log.name;
                                logSelector.appendChild(option);
                            });
                            fetchLogs(); // Charger le contenu du premier log de la liste
                        } else {
                            logSelector.innerHTML = `<option>{{ _('No logs found') }}</option>`;
                            fetchLogs(); // Affichera le message "aucun log"
                        }
                    } catch (error) {
                        logSelector.innerHTML = `<option>{{ _('Loading error') }}</option>`;
                    }
                }

