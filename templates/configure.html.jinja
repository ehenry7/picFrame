                    </div>

                    <div style="display: flex; align-items: center; margin-bottom: 8px;">
                        <label for="weather_city" style="min-width: 200px;">City:</label>
                        <select id="weather_city" name="weather_city">
                            {% for city in weather_cities %}
                            <option value="{{ city.name }}" {% if config.get('weather_city') == city.name %}selected{% endif %}>
                                {{ city.name }}
                            </option>
                            {% endfor %}
                        </select>
                    </div>

                    <div style="display: flex; align-items: center; margin-bottom: 8px;">
                        <p class="text-sm text-gray-600">Weather data is provided by Open-Meteo. No API key is required.</p>
                    </div>

                    <div style="display: flex; align-items: center; margin-bottom: 8px;">
                        <label for="weather_units" style="min-width: 200px;">Units:</label>
                        <select name="weather_units" id="weather_units">
                            <option value="metric" {% if config.get('weather_units')=='metric' %}selected{% endif %}>Celsius</option>
                            <option value="imperial" {% if config.get('weather_units')=='imperial' %}selected{% endif
                                %}>Fahrenheit</option>
                        </select>
                    </div>

                    <div style="display: flex; align-items: center; margin-bottom: 8px;">
                        <label for="weather_update_interval_minutes" style="min-width: 200px;">Update interval (minutes):</label>
                        <input type="number" name="weather_update_interval_minutes"
                            value="{{ config.get('weather_update_interval_minutes', 30) }}">
                    </div>
                </fieldset>

                <fieldset class="mt-6">
                    <legend><strong>{{ _("Tide display (StormGlass Tide API)") }}</strong></legend>
                    <p class="text-sm text-gray-600 mb-3">{{ _("Uses the API") }} <a href="https://stormglass.io/"
                            target="_blank" class="text-blue-600 hover:underline">StormGlass</a>. {{ _("An API key is
                        required. You can find your port coordinates on sites like") }} <a
                            href="https://www.latlong.net/" target="_blank"
                            class="text-blue-600 hover:underline">latlong.net</a>.</p>
                    <p class="text-sm text-gray-600 mb-3">{{ _("Note: This API provides tide heights, but not
                        the tidal coefficient.") }}</p>

                    <div style="margin-bottom: 8px;">
                        <label>
                            <input type="checkbox" name="show_tides" {% if config.get('show_tides', False) %}checked{% endif %}> <span class="ml-2">{{ _("Show tide information") }}</span>
                        </label>
                    </div>

                    <div style="display: flex; align-items: center; margin-bottom: 8px;">
                        <label for="tide_latitude" style="min-width: 200px;">{{ _("Latitude (eg: 48.3904):") }}</label>
                        <input type="text" id="tide_latitude" name="tide_latitude"
                            value="{{ config.get('tide_latitude', '') }}">
                    </div>

                    <div style="display: flex; align-items: center; margin-bottom: 8px;">
                        <label for="tide_longitude" style="min-width: 200px;">{{ _("Longitude (eg: -4.4861):")
                            }}</label>
                        <input type="text" id="tide_longitude" name="tide_longitude"
                            value="{{ config.get('tide_longitude', '') }}">
                    </div>

                    <div style="display: flex; align-items: center; margin-bottom: 8px;">
                        <label for="stormglass_api_key" style="min-width: 200px;">{{ _("Api Key StormGlass :")
                            }}</label>
                        <div class="relative flex-grow">
                            <input type="password" id="stormglass_api_key" name="stormglass_api_key"
                                value="{{ config.get('stormglass_api_key', '') }}" class="w-full pr-10">
                            <div class="absolute inset-y-0 right-0 pr-3 flex items-center">
                                <button type="button"
                                    class="toggle-password-btn text-gray-500 hover:bg-gray-200 rounded-md transition-colors w-auto p-2 flex items-center justify-center mt-0 bg-transparent border-none font-normal"
                                    data-target="stormglass_api_key" title="{{ _('Show/Hide photos') }}">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div style="display: flex; align-items: center; margin-bottom: 8px;">
                        <label for="tide_offset_x" style="min-width: 200px;">{{ _("Horizontal offset (px):")
                            }}</label>
                        <input type="number" id="tide_offset_x" name="tide_offset_x"
                            value="{{ config.get('tide_offset_x', 0) }}">
                    </div>

                    <div style="display: flex; align-items: center; margin-bottom: 8px;">
                        <label for="tide_offset_y" style="min-width: 200px;">{{ _("Vertical offset (px):") }}</label>
                        <input type="number" id="tide_offset_y" name="tide_offset_y"
                            value="{{ config.get('tide_offset_y', 0) }}">
                    </div>

                    <div class="mt-2 mb-4">
                        <button type="button" id="testStormglassApiKeyBtn"
                            class="bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded text-sm inline-flex items-center"><i
                                class="fas fa-plug mr-2"></i>{{ _("Test the connection") }}</button>
                        <button type="button" id="forceTideUpdateBtn"
                            class="bg-green-500 hover:bg-green-600 text-white font-bold py-2 px-4 rounded text-sm inline-flex items-center"><i
                                class="fas fa-sync-alt mr-2"></i>{{ _("Force update") }}</button>
                    </div>
                    <div class="mb-4">
                        <span id="stormglassApiTestResult" class="ml-4 font-medium"></span>
                        <span id="forceTideUpdateResult" class="ml-4 font-medium"></span>
                    </div>

                    <div class="mt-6">
                        <h4 class="font-semibold text-gray-800 mb-2">{{ _("Current State of the Tides") }}</h4>
                        <div id="tide-status-container" class="p-3 bg-gray-100 rounded-lg border text-sm">
                            <div id="tide-list" class="space-y-1"></div>
                            <p class="mt-3 pt-2 border-t border-gray-300"><strong>{{ _("Last data update
                                    :") }}</strong> <span id="tide-last-update" class="font-mono">{{ _("Loading...")
                                    }}</span></p>
                            <p><strong>{{ _("API Status:") }}</strong> <span id="tide-api-status"
                                    class="font-mono text-gray-500">{{ _("Loading...") }}</span></p>
                        </div>
                    </div>
                </fieldset>

                <fieldset class="mt-6">
                    <legend><strong>{{ _("Time zone") }}</strong></legend>
                    <div class="p-3 bg-gray-100 rounded-lg border">
                        <p><strong>{{ _("Current system time zone:") }}</strong> <span class="font-mono" id="current-timezone">{{
                                config.get('timezone', _('Undefined')) }}</span></p>
                        {% if config.get('timezone_source') == 'fallback' %}
                        <div class="mt-2 p-3 text-sm text-yellow-800 bg-yellow-100 rounded-lg" role="alert">
                            <i class="fas fa-exclamation-triangle mr-2"></i>
                            <strong>{{ _("Attention :") }}</strong> {{ _("Automatic time zone detection has
                            failed during installation. The system is set to <strong>UTC</strong>. The time
                            displayed may be incorrect.")|safe }}
                        </div>
                        {% endif %}
                        <div class="mt-3">
                            <label for="timezone" class="block text-sm font-medium text-gray-700 mb-1">{{ _("Time zone") }}</label>
                            <select id="timezone" name="timezone" class="w-full">
                                {% set current_timezone = config.get('timezone', 'Europe/Paris') %}
                                <option value="{{ current_timezone }}" selected>{{ current_timezone }}</option>
                                {% for tz in available_timezones if tz != current_timezone %}
                                <option value="{{ tz }}">{{ tz }}</option>
                                {% endfor %}
                            </select>
                            <p class="text-xs text-gray-500 mt-1">{{ _("The change will be applied to the system after saving. A restart may be necessary.") }}</p>
                        </div>
                    </div>
                </fieldset>
            </div>


            <div id="tab-sources" class="tabcontent">
                <fieldset class="mt-4">
                    <legend>
                        <h3>{{ _("Sources to display in the slideshow") }}</h3>
                    </legend>
                    <p class="mb-3 text-gray-700">{{ _("Select photo sources to include in the slideshow.
                        Photos will be mixed between the selected sources.") }}</p>

                    {% for source, label in source_labels.items() if source not in ['usb', 'smartphone', 'guests'] %}
                    <div class="form-check form-switch my-2">
                        <input class="form-check-input" type="checkbox" id="display_source_extra_{{ loop.index }}" name="display_sources" value="{{ source }}" {% if source in config.display_sources %}checked{% endif %}>
                        <label class="form-check-label ml-2" for="display_source_extra_{{ loop.index }}">{{ label }}</label>
                    </div>
                    {% endfor %}
                    <div class="form-check form-switch my-2">
                        <input class="form-check-input" type="checkbox" id="display_source_usb" name="display_sources" value="usb" {% if 'usb' in config.display_sources %}checked{% endif %}>
                        <label class="form-check-label ml-2" for="display_source_usb">{{ _("USB Photos") }}</label>
                    </div>
                    <div class="form-check form-switch my-2">
                        <input class="form-check-input" type="checkbox" id="display_source_smartphone" name="display_sources" value="smartphone" {% if 'smartphone' in config.display_sources %}checked{% endif %}>
                        <label class="form-check-label ml-2" for="display_source_smartphone">{{ _("Smartphone Photos") }}</label>
                    </div>
                    <div class="form-check form-switch my-2">
                        <input class="form-check-input" type="checkbox" id="display_source_invites" name="display_sources" value="guests" {% if 'guests' in config.display_sources %}checked{% endif %}>
                        <label class="form-check-label ml-2" for="display_source_invites">{{ _('Guest photos
                            (validated)') }}</label>
                    </div>
                </fieldset>
            </div>

            <div id="tab-metadata" class="tabcontent">
                <fieldset>
                    <legend>
                        <h3><i class="fas fa-info-circle mr-2"></i>{{ _("Viewing photo metadata") }}</h3>
                    </legend>
                    <p class="text-sm text-gray-600 mb-4">{{ _("Configure the information (date, location) displayed for your photos.") }}</p>

                    <!-- Date -->
                    <div class="form-check form-switch my-3">
                        <input class="form-check-input" type="checkbox" id="show_photo_date" name="show_photo_date" {% if config.get('show_photo_date') %}checked{% endif %}>
                        <label class="form-check-label ml-2" for="show_photo_date">{{ _("Show shooting date") }}</label>
                    </div>
                    <div class="mb-4">
                        <label for="photo_date_format" class="block text-sm font-medium text-gray-700">{{ _("Format of
                            the date") }}</label>
                        <input type="text" id="photo_date_format" name="photo_date_format"
                            value="{{ config.get('photo_date_format', '%Y') }}"
                            class="mt-1 block w-full rounded-md border-gray-300 shadow-sm">
                        <p class="text-xs text-gray-500 mt-1">{{ _("Uses Python formatting codes (ex: %%d/%%m/%%Y, %%B %%Y).") }}</p>
                        {{ date_format_help() }}
                    </div>

                    <!-- Location -->
                    <div class="form-check form-switch my-3">
                        <input class="form-check-input" type="checkbox" id="show_photo_location" name="show_photo_location" {% if config.get('show_photo_location') %}checked{% endif %}>
                        <label class="form-check-label ml-2" for="show_photo_location">{{ _("Show location
                            (city/country)") }}</label>
                    </div>
                    <div class="mb-4">
                        <label for="photo_location_format" class="block text-sm font-medium text-gray-700">{{ _("Format
                            of the location") }}</label>
                        <select id="photo_location_format" name="photo_location_format"
                            class="mt-1 block w-full rounded-md border-gray-300 shadow-sm">
                            <option value="city_country" {% if config.get('photo_location_format')=='city_country'
                                %}selected{% endif %}>{{ _("City, Country") }}</option>
                            <option value="city" {% if config.get('photo_location_format')=='city' %}selected{% endif
                                %}>{{ _("City only") }}</option>
                            <option value="country" {% if config.get('photo_location_format')=='country' %}selected{%
                                endif %}>{{ _("Country only") }}</option>
                        </select>
                    </div>

                    <!-- Country Flag -->
                    <div class="form-check form-switch my-3">
                        <input class="form-check-input" type="checkbox" id="show_country_flag" name="show_country_flag" {% if config.get('show_country_flag') %}checked{% endif %}>
                        <label class="form-check-label ml-2" for="show_country_flag">{{ _("Show country flag") }}</label>
                    </div>
                    <div class="mb-4">
                        <label for="country_flag_size" class="block text-sm font-medium text-gray-700">{{ _("Size of
                            flag") }}</label>
                        <select id="country_flag_size" name="country_flag_size"
                            class="mt-1 block w-full rounded-md border-gray-300 shadow-sm">
                            <option value="128x96" {% if config.get('country_flag_size')=='128x96' %}selected{% endif
                                %}>128x96</option>
                            <option value="192x144" {% if config.get('country_flag_size')=='192x144' %}selected{% endif
                                %}>192x144</option>
                            <option value="256x192" {% if config.get('country_flag_size')=='256x192' %}selected{% endif
                                %}>256x192</option>
                        </select>
                    </div>
                    <div class="mb-4">
                        <label for="country_flag_opacity" class="block text-sm font-medium text-gray-700">{{ _("Opacity
                            of the flag (0.1 to 1.0)") }}</label>
                        <input type="number" step="0.1" min="0.1" max="1.0" id="country_flag_opacity"
                            name="country_flag_opacity" value="{{ config.get('country_flag_opacity', 1.0) }}"
                            class="mt-1 block w-full rounded-md border-gray-300 shadow-sm">
                    </div>
                    <div class="mb-4">
                        <label for="country_flag_position" class="block text-sm font-medium text-gray-700">{{
                            _("Flag position") }}</label>
                        <select id="country_flag_position" name="country_flag_position"
                            class="mt-1 block w-full rounded-md border-gray-300 shadow-sm">
                            <option value="top_right" {% if config.get('country_flag_position')=='top_right'
                                %}selected{% endif %}>{{ _("Top right") }}</option>
                            <option value="top_left" {% if config.get('country_flag_position')=='top_left' %}selected{%
                                endif %}>{{ _("Top left") }}</option>
                            <option value="bottom_right" {% if config.get('country_flag_position')=='bottom_right'
                                %}selected{% endif %}>{{ _("Bottom right") }}</option>
                            <option value="bottom_left" {% if config.get('country_flag_position')=='bottom_left'
                                %}selected{% endif %}>{{ _("Bottom left") }}</option>
                        </select>
                    </div>
                    <div class="grid grid-cols-2 gap-4 mb-4">
                        <div>
                            <label for="country_flag_offset_x" class="block text-sm font-medium text-gray-700">{{
                                _("Horizontal offset (px)") }}</label>
                            <input type="number" id="country_flag_offset_x" name="country_flag_offset_x"
                                value="{{ config.get('country_flag_offset_x', 15) }}"
                                class="mt-1 block w-full rounded-md border-gray-300 shadow-sm">
                        </div>
                        <div>
                            <label for="country_flag_offset_y" class="block text-sm font-medium text-gray-700">{{
                                _("Vertical offset (px)") }}</label>
                            <input type="number" id="country_flag_offset_y" name="country_flag_offset_y"
                                value="{{ config.get('country_flag_offset_y', 15) }}"
                                class="mt-1 block w-full rounded-md border-gray-300 shadow-sm">
                        </div>
                    </div>

                    <!-- Style & Position -->
                    <h4 class="text-lg font-semibold mt-6 pt-4 border-t">{{ _("Style and Positioning") }}</h4>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-2">
                        <div>
                            <label for="photo_metadata_font_size" class="block text-sm font-medium text-gray-700">{{
                                _("Font size") }}</label>
                            <input type="number" id="photo_metadata_font_size" name="photo_metadata_font_size"
                                value="{{ config.get('photo_metadata_font_size', 23) }}"
                                class="mt-1 block w-full rounded-md border-gray-300 shadow-sm">
                        </div>
                        <div>
                            <label for="photo_metadata_font_path" class="block text-sm font-medium text-gray-700">{{
                                _("Police") }}</label>
                            <select id="photo_metadata_font_path" name="photo_metadata_font_path"
                                class="mt-1 block w-full rounded-md border-gray-300 shadow-sm">
                                {% set fonts = [
                                ('/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf', 'DejaVu Sans Bold'),
                                ('/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf', 'DejaVu Sans'),
                                ('/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf', 'Liberation Sans'),
                                ('/usr/share/fonts/truetype/freefont/FreeSans.ttf', 'FreeSans')
                                ] %}
                                {% for path, label in fonts %}
                                <option value="{{ path }}" {% if config.get('photo_metadata_font_path')==path
                                    %}selected{% endif %}>{{ label }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div>
                            <label for="photo_metadata_color" class="block text-sm font-medium text-gray-700">{{
                                _("Text color (hex)") }}</label>
                            <input type="text" id="photo_metadata_color" name="photo_metadata_color"
                                value="{{ config.get('photo_metadata_color', '#ffffff') }}"
                                class="mt-1 block w-full rounded-md border-gray-300 shadow-sm">
                        </div>
                        <div>
                            <label for="photo_metadata_outline_color" class="block text-sm font-medium text-gray-700">{{
                                _("Outline color (hex)") }}</label>
                            <input type="text" id="photo_metadata_outline_color" name="photo_metadata_outline_color"
                                value="{{ config.get('photo_metadata_outline_color', '#000000') }}"
                                class="mt-1 block w-full rounded-md border-gray-300 shadow-sm">
                        </div>
                        <div>
                            <label for="photo_metadata_position" class="block text-sm font-medium text-gray-700">{{
                                _("Position") }}</label>
                            <select id="photo_metadata_position" name="photo_metadata_position"
                                class="mt-1 block w-full rounded-md border-gray-300 shadow-sm">
                                <option value="bottom_left" {% if config.get('photo_metadata_position')=='bottom_left'
                                    %}selected{% endif %}>{{ _("Bottom left") }}</option>
                                <option value="bottom_right" {% if config.get('photo_metadata_position')=='bottom_right'
                                    %}selected{% endif %}>{{ _("Bottom right") }}</option>
                                <option value="bottom_center" {% if
                                    config.get('photo_metadata_position')=='bottom_center' %}selected{% endif %}>{{
                                    _("Bottom center") }}</option>
                                <option value="top_left" {% if config.get('photo_metadata_position')=='top_left'
                                    %}selected{% endif %}>{{ _("Top left") }}</option>
                                <option value="top_right" {% if config.get('photo_metadata_position')=='top_right'
                                    %}selected{% endif %}>{{ _("Top right") }}</option>
                            </select>
                        </div>
                        <div>
                            <label for="photo_metadata_offset_x" class="block text-sm font-medium text-gray-700">{{
                                _("Horizontal offset (px)") }}</label>
                            <input type="number" id="photo_metadata_offset_x" name="photo_metadata_offset_x"
                                value="{{ config.get('photo_metadata_offset_x', 0) }}"
                                class="mt-1 block w-full rounded-md border-gray-300 shadow-sm">
                        </div>
                        <div>
                            <label for="photo_metadata_offset_y" class="block text-sm font-medium text-gray-700">{{
                                _("Vertical offset (px)") }}</label>
                            <input type="number" id="photo_metadata_offset_y" name="photo_metadata_offset_y"
                                value="{{ config.get('photo_metadata_offset_y', 0) }}"
                                class="mt-1 block w-full rounded-md border-gray-300 shadow-sm">
                        </div>
                    </div>

                    <!-- Background -->
                    <div class="form-check form-switch my-3 pt-4 border-t">
                        <input class="form-check-input" type="checkbox" id="photo_metadata_background_enabled" name="photo_metadata_background_enabled" {% if config.get('photo_metadata_background_enabled') %}checked{% endif %}>
                        <label class="form-check-label ml-2" for="photo_metadata_background_enabled">{{ _("Show a semi-transparent background behind the metadata") }}</label>
                    </div>
                    <div class="mb-4">
                        <label for="photo_metadata_background_color" class="block text-sm font-medium text-gray-700">{{
                            _("Background color (hex RGBA)") }}</label>
                        <input type="text" id="photo_metadata_background_color" name="photo_metadata_background_color"
                            value="{{ config.get('photo_metadata_background_color', '#00000080') }}"
                            class="mt-1 block w-full rounded-md border-gray-300 shadow-sm">
                    </div>
                </fieldset>
            </div>

            <!-- The save button is placed here inside the form, after the configuration tabs. -->
            <button type="submit" id="save-changes-btn" class="save-button">{{ _("Save changes")
                }}</button>

        </form>

        <div id="tab-actions" class="tabcontent">
            <fieldset>
                <legend>
                    <h3>{{ _("Actions") }}</h3>
                </legend>

                <div class="action-group">
                    <h4>{{ _("Slideshow management") }}</h4>
                    <form method="POST" action="/toggle_slideshow">
                        <button type="submit"
                            class="system-button {% if slideshow_running %}bg-red-500 hover:bg-red-700{% else %}bg-green-500 hover:bg-green-700{% endif %} text-white font-bold py-2 px-4 rounded">
                            {% if slideshow_running %}
                            <i class="fas fa-stop"></i> {{ _("Stop slideshow") }}
                            {% else %}
                            <i class="fas fa-play"></i> {{ _("Start slideshow") }}
                            {% endif %}
                        </button>
                    </form>
                    <div class="flex justify-center items-center gap-4 mt-4" id="slideshow-controls-actions">
                        <button type="button"
                            class="notification-toggle-btn bg-gray-600 hover:bg-gray-700 text-white p-3 rounded-full w-16 h-16 flex items-center justify-center"
                            title="{{ _('Enable/Disable notifications') }}">
                            <i class="fas fa-bell fa-lg"></i>
                        </button>
                        <button type="button"
                            class="slideshow-control-btn bg-gray-600 hover:bg-gray-700 text-white p-3 rounded-full w-16 h-16 flex items-center justify-center"
                            data-command="previous" title="{{ _('Previous photo') }}">
                            <i class="fas fa-backward fa-lg"></i>
                        </button>
                        <button type="button"
                            class="slideshow-control-btn bg-gray-600 hover:bg-gray-700 text-white p-3 rounded-full w-20 h-20 flex items-center justify-center"
                            data-command="toggle_pause" title="{{ _('Pause/Reading') }}">
                            <i class="slideshow-pause-icon fas fa-pause fa-2x"></i>
                        </button>
                        <button type="button"
                            class="slideshow-control-btn bg-gray-600 hover:bg-gray-700 text-white p-3 rounded-full w-16 h-16 flex items-center justify-center"
                            data-command="next" title="{{ _('Next photo') }}">
                            <i class="fas fa-forward fa-lg"></i>
                        </button>
                    </div>
                </div>

                <div class="action-group">
                    <h4>{{ _("Importing photos") }}</h4>
                    <button id="usb-import-btn"
                        class="import-button bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">
                        <i class="fas fa-file-import"></i> {{ _("Import from USB drive") }}
                    </button>
                    <div id="usb-progress-container" class="progress-container hidden">
                        <div id="usb-progress-bar" class="progress-bar"></div>
                    </div>
                    <div id="usb-import-status" class="status-messages"></div>

                    <!-- NEW: Container for the preparation preview -->
                    <div id="preparation-preview-container"
                        class="hidden mt-4 p-3 bg-gray-100 rounded-lg border text-center">
                        <p class="text-sm font-semibold text-gray-600 mb-2">{{ _("Preparation in progress...") }}</p>
                        <img id="preparation-preview-image" src="" alt="{{ _('Photo being prepared') }}"
                            class="mx-auto max-w-xs max-h-48 rounded shadow">
                    </div>

                    <div class="mt-4 pt-4 border-t border-gray-200">
                    </div>

                    <div id="smartphone-upload-form"
                        class="mt-4 pt-4 border-t border-gray-200">
                        <p class="text-sm text-gray-600 mb-3">{{ _("Select photos or a folder from this device. Duplicate photos are skipped.") }}</p>
                        <input type="file" id="photo-files-input" accept=".jpg,.jpeg,.png,.heic,.heif" multiple class="hidden">
                        <input type="file" id="photo-folder-input" webkitdirectory multiple class="hidden">
                        <button type="button" id="import-smartphone-btn"
                            class="import-button bg-green-500 hover:bg-green-700 text-white font-bold py-2 px-4 rounded">
                            <i class="fas fa-images"></i> {{ _("Import photos") }}
                        </button>
                        <button type="button" id="import-folder-btn"
                            class="import-button bg-green-500 hover:bg-green-700 text-white font-bold py-2 px-4 rounded">
                            <i class="fas fa-folder-open"></i> {{ _("Import folder") }}
                        </button>
                    </div>
                    <div id="smartphone-progress-container" class="progress-container hidden">
                        <div id="smartphone-progress-bar" class="progress-bar"></div>
                    </div>
                    <div id="smartphone-import-status" class="status-messages"></div>

                    <hr class="my-6">
                    <h5 class="text-lg font-semibold mb-2 flex items-center gap-2"><i class="fas fa-file-audio"></i> {{ _("Importation :") }}</h5>
                    <p class="text-sm text-gray-600 mb-3">{{ _("Upload your own MP3 or WAV files to accompany your playlists.") }}</p>
                    <div class="flex items-center gap-4">
                        <input type="file" id="music-upload-input" accept=".mp3,.wav" class="hidden">
                        <button type="button" onclick="document.getElementById('music-upload-input').click()" class="system-button bg-purple-500 hover:bg-purple-600 text-white font-bold py-2 px-4 rounded">
