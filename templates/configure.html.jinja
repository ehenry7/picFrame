                // ----- USB IMPORT MANAGEMENT -----
                function handleImportProcess(source) {
                    const btn = document.getElementById(`${source}-import-btn`);
                    const progressBar = document.getElementById(`${source}-progress-bar`);
                    const progressContainer = document.getElementById(`${source}-progress-container`);
                    const statusDiv = document.getElementById(`${source}-import-status`);
                    const allImportButtons = document.querySelectorAll('.import-button, #import-smartphone-btn');

                    const previewContainer = document.getElementById('preparation-preview-container');
                    const previewImage = document.getElementById('preparation-preview-image');
                    const originalBtnHTML = btn.innerHTML;

                    allImportButtons.forEach(b => {
                        b.disabled = true;
                        b.classList.add("opacity-50", "cursor-not-allowed");
                    });
                    btn.innerHTML = `<i class="fas fa-spinner fa-spin"></i> {{ _("Import in progress...") }}`;

                    progressBar.style.width = "0%";
                    progressBar.textContent = "0%";
                    progressContainer.classList.remove("hidden");
                    statusDiv.innerHTML = "";

                    function restoreButtons() {
                        allImportButtons.forEach(b => {
                            b.disabled = false;
                            b.classList.remove("opacity-50", "cursor-not-allowed");
                        });
                        btn.innerHTML = originalBtnHTML;
                        if (previewContainer) previewContainer.classList.add('hidden');
                    }

                    function startPreparation() {
                        //displayMessage(statusDiv, "Step 1/2: Import complete. Starting preparation...", 'info');
                        progressBar.style.width = "25%";
                        progressBar.textContent = "25%";

                        if (previewContainer) previewContainer.classList.remove('hidden');
                        const prepareEventSource = new EventSource(`/prepare-photos?source=${source}`);

                        prepareEventSource.onmessage = (event) => {
                            try {
                                const data = JSON.parse(event.data);
                                progressBar.style.width = `${data.percent || 0}%`;
                                progressBar.textContent = `${data.percent || 0}%`;
                                displayMessage(statusDiv, `{{ _("Preparation :") }} ${data.message}`, data.type);

                                // Update the preview image if provided.
                                if (data.current_photo_url && previewImage) {
                                    previewImage.src = data.current_photo_url;
                                }

                                if (data.type === 'done' || data.stage === 'PREPARING_COMPLETE') {
                                    prepareEventSource.close();
                                    displayMessage(statusDiv, "{{ _('Preparation complete! Restarting the slideshow...') }}", 'success');

                                    // Send the request to restart the slideshow.
                                    fetch('/api/slideshow/restart_for_update', { method: 'POST' })
                                        .then(response => response.json())
                                        .then(result => {
                                            if (result.success) {
                                                displayMessage(statusDiv, "{{ _('Slideshow restarted. Reloading the page...') }}", 'success');
                                            }
                                            setTimeout(() => { location.reload(); }, 2000);
                                        });
                                } else if (data.type === 'error') {
                                    prepareEventSource.close();
                                    restoreButtons();
                                }
                            } catch (e) {
                                displayMessage(statusDiv, "{{ _('Invalid staging data received from server.') }}", 'error');
                                prepareEventSource.close();
                                restoreButtons();
                            }
                        };

                        prepareEventSource.onerror = () => {
                            prepareEventSource.close();
                            displayMessage(statusDiv, "{{ _('Error connecting to the server for preparing photos.') }}", 'error');
                            restoreButtons();
                        };
                    }

                    const importEventSource = new EventSource(`/import-${source}`);

                    importEventSource.onmessage = (event) => {
                        try {
                            const data = JSON.parse(event.data);
                            progressBar.style.width = `${data.percent || 0}%`;
                            progressBar.textContent = `${data.percent || 0}%`;
                            displayMessage(statusDiv, `{{ _("Importation :") }} ${data.message}`, data.type);

                            if (data.type === 'done') {
                                importEventSource.close();
                                startPreparation();
                            } else if (data.type === 'error') {
                                importEventSource.close();
                                restoreButtons();
                            }
                        } catch (e) {
                            displayMessage(statusDiv, "{{ _('Données d\'import invalides reçues du serveur.') }}", 'error');
                            importEventSource.close();
                            restoreButtons();
                        }
                    };

                    importEventSource.onerror = () => {
                        importEventSource.close();
                        displayMessage(statusDiv, `{{ _("Error connecting to server for import") }} ${source}.`, 'error');
                        restoreButtons();
                    };
                }

                document.getElementById("usb-import-btn").addEventListener("click", () => handleImportProcess('usb'));

                // --- Tide status ---
                async function fetchTideInfo() {
                    const tideListDiv = document.getElementById('tide-list');
                    const tideLastUpdate = document.getElementById('tide-last-update');
                    const tideApiStatus = document.getElementById('tide-api-status');

                    try {
                        const response = await fetch('/api/tide_info');
                        const data = await response.json();

                        tideListDiv.innerHTML = ''; // Vider la liste

                        if (data.success) {
                            tideLastUpdate.textContent = data.last_update || 'N/A';
                            tideApiStatus.textContent = data.api_status || 'OK';
                            tideApiStatus.className = data.api_status.includes('cooldown') || data.api_status.includes('Erreur') ? 'font-mono text-yellow-600' : 'font-mono text-green-600';

                            if (data.tides && data.tides.length > 0) {
                                data.tides.forEach(tide => {
                                    const p = document.createElement('p');
                                    p.innerHTML = `<strong>${tide.type}:</strong> <span class="font-mono">${tide.time} (${tide.height})</span>`;
                                    tideListDiv.appendChild(p);
                                });
                            } else {
                                tideListDiv.innerHTML = `<p class="italic">{{ _("No tide data to display.") }}</p>`;
                            }
                        } else {
                            tideApiStatus.textContent = data.message || "{{ _('Unable to load data.') }}";
                            tideApiStatus.className = 'font-mono text-red-600';
                        }
                    } catch (error) {
                        console.error("Erreur de communication avec l'API des marées:", error);
                        tideApiStatus.textContent = "{{ _('Server connection error.') }}";
                        tideApiStatus.className = 'font-mono text-red-600';
                    }
                }


                // ----- TEST STORMGLASS API -----
                const testStormglassBtn = document.getElementById("testStormglassApiKeyBtn");
                if (testStormglassBtn) {
                    testStormglassBtn.addEventListener("click", async () => {
                        const btn = testStormglassBtn;
                        const statusSpan = document.getElementById("stormglassApiTestResult");

                        const apiKey = document.getElementById("stormglass_api_key").value;
                        const lat = document.getElementById("tide_latitude").value;
                        const lon = document.getElementById("tide_longitude").value;

                        statusSpan.textContent = "Test en cours...";
                        statusSpan.className = "ml-4 font-medium text-blue-600";
                        btn.disabled = true;

                        try {
                            const response = await fetch('/test-stormglass-api', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ api_key: apiKey, lat: lat, lon: lon }),
                            });

                            const result = await response.json();

                            statusSpan.textContent = result.message;
                            statusSpan.className = result.success ? "ml-4 font-medium text-green-600" : "ml-4 font-medium text-red-600";

                        } catch (error) {
                            statusSpan.textContent = "Erreur de communication avec le serveur.";
                            statusSpan.className = "ml-4 font-medium text-red-600";
                        } finally {
                            btn.disabled = false;
                        }
                    });
                }

                // ----- FORCE TIDE UPDATE -----
                const forceTideBtn = document.getElementById("forceTideUpdateBtn");
                if (forceTideBtn) {
                    forceTideBtn.addEventListener("click", async () => {
                        const btn = forceTideBtn;
                        const statusSpan = document.getElementById("forceTideUpdateResult");

                        statusSpan.textContent = "{{ _('Update in progress...') }}";
                        statusSpan.className = "ml-4 font-medium text-blue-600";
                        btn.disabled = true;

                        try {
                            const response = await fetch('/api/force_tide_update', {
                                method: 'POST'
                            });

                            const result = await response.json();

                            statusSpan.textContent = result.message;
                            statusSpan.className = result.success ? "ml-4 font-medium text-green-600" : "ml-4 font-medium text-red-600";

                            if (result.success) {
                                fetchTideInfo(); // Rafraîchir l'affichage de l'état des marées
                            }
                        } catch (error) {
                            statusSpan.textContent = "{{ _('Communication error with the server.') }}";
                            statusSpan.className = "ml-4 font-medium text-red-600";
                        } finally {
                            btn.disabled = false;
                        }
                    });
                }

                // Periodic update.
                fetchTideInfo(); // Appel initial
                setInterval(fetchTideInfo, 30000); // Mise à jour toutes les 30 secondes

                // ----- IMPORT SMARTPHONE -----
                const photoFilesInput = document.getElementById('photo-files-input');
                const photoFolderInput = document.getElementById('photo-folder-input');
                document.getElementById('import-smartphone-btn').addEventListener('click', () => photoFilesInput.click());
                document.getElementById('import-folder-btn').addEventListener('click', () => photoFolderInput.click());
                [photoFilesInput, photoFolderInput].forEach(input => input.addEventListener('change', async function () {
                    const formData = new FormData();
                    const files = Array.from(this.files).filter(file => /\.(jpe?g|png|heic|heif)$/i.test(file.name));
                    files.forEach(file => formData.append('photos', file, file.name));
                    const btn = document.getElementById(input === photoFolderInput ? 'import-folder-btn' : 'import-smartphone-btn');
                    const originalButtonHTML = btn.innerHTML;
                    const progressBar = document.getElementById('smartphone-progress-bar');
                    const progressContainer = document.getElementById('smartphone-progress-container');
                    const statusDiv = document.getElementById('smartphone-import-status');
                    const allImportButtons = document.querySelectorAll('.import-button, #import-smartphone-btn');
                    let hasErrorOccurred = false; // Flag to track errors
                    let completed = false;

                    // Check if files were selected
                    if (!formData.has('photos') || !formData.get('photos').name) {
                        displayMessage(statusDiv, "{{ _('Please select at least one file.') }}", 'error');
                        return;
                    }

                    // Disable all import buttons
                    allImportButtons.forEach(b => {
                        b.disabled = true;
                        b.classList.add("opacity-50", "cursor-not-allowed");
                    });
                    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> {{ _("Sending in progress...") }}';

                    // Reset UI
                    progressBar.style.width = '0%';
                    progressBar.textContent = '0%';
                    progressContainer.classList.remove('hidden');
                    statusDiv.innerHTML = '';

                    try {
                        const response = await fetch('/import-smartphone', {
                        method: 'POST',
                        body: formData
                        });
                            if (!response.ok) {
                                if (response.status === 413) {
                                    throw new Error({{ _("Selection exceeds the 500 MB upload limit. Import fewer photos at a time.") | tojson }});
                                }
                                throw new Error(`Erreur HTTP: ${response.status}`);
                            }
                            const reader = response.body.getReader();
                            const decoder = new TextDecoder();

                            let buffer = '';
                            while (true) {
                                    const { done, value } = await reader.read();
                                    buffer += done ? decoder.decode() : decoder.decode(value, { stream: true });
                                    const lines = buffer.split('\n\n');
                                    buffer = lines.pop();
                                    lines.forEach(line => {
                                        if (line.startsWith('data: ')) {
                                            try {
                                                const data = JSON.parse(line.substring(6));
                                                progressBar.style.width = `${data.percent || 0}%`;
                                                progressBar.textContent = `${data.percent || 0}%`;
                                                displayMessage(statusDiv, data.message, data.type);
                                                if (data.type === 'error') {
                                                    hasErrorOccurred = true;
                                                }
                                                if (data.type === 'done') completed = true;
                                            } catch (e) {
                                                displayMessage(statusDiv, "{{ _('Datas received from the server are invalid.') }}", 'error');
                                                hasErrorOccurred = true;
                                            }
                                        }
                                    });
                                    if (done) break;
                            }
                            if (!completed && !hasErrorOccurred) {
                                throw new Error({{ _("Import ended before completion. Please try again.") | tojson }});
                            }
                            if (completed && !hasErrorOccurred) {
                                const sourceCheckbox = document.getElementById('display_source_smartphone');
                                if (sourceCheckbox) sourceCheckbox.checked = true;
                            }
                    } catch (error) {
                            displayMessage(statusDiv, `{{ _('Communication error:') }} ${error.message}`, 'error');
                    } finally {
                            allImportButtons.forEach(b => { b.disabled = false; b.classList.remove("opacity-50", "cursor-not-allowed"); });
                            btn.innerHTML = originalButtonHTML;
                            input.value = '';
                    }
                }));

                // --- MUSIC UPLOAD MANAGEMENT ---
                const musicUploadInput = document.getElementById('music-upload-input');
                const musicUploadFilename = document.getElementById('music-upload-filename');
                const musicUploadBtn = document.getElementById('music-upload-btn');
                const musicUploadStatus = document.getElementById('music-upload-status');

                if (musicUploadInput) {
                    musicUploadInput.addEventListener('change', function() {
                        if (this.files && this.files[0]) {
                            musicUploadFilename.textContent = this.files[0].name;
                            musicUploadBtn.classList.remove('hidden');
                        } else {
                            musicUploadFilename.textContent = '';
                            musicUploadBtn.classList.add('hidden');
                        }
                    });
                }

                if (musicUploadBtn) {
                    musicUploadBtn.addEventListener('click', async function() {
                        const file = musicUploadInput.files[0];
                        if (!file) return;
                        const formData = new FormData();
                        formData.append('music_file', file);
                        this.disabled = true;
                        this.innerHTML = '<i class="fas fa-spinner fa-spin"></i> {{ _("Sending in progress...") }}';
                        try {
                            const response = await fetch('/api/upload_music', { method: 'POST', body: formData });
                            const result = await response.json();
                            if (result.success) {
                                displayMessage(musicUploadStatus, result.message, 'success');
                                musicUploadInput.value = '';
                                musicUploadFilename.textContent = '';
                                musicUploadBtn.classList.add('hidden');
                                await loadMusicFiles(); // Rafraîchir les listes de sélection de musique
                            } else { displayMessage(musicUploadStatus, result.message, 'error'); }
                        } catch (error) {
                            displayMessage(musicUploadStatus, "{{ _('Communication error.') }}", 'error');
                        } finally {
                            this.disabled = false;
                            this.innerHTML = '<i class="fas fa-upload"></i> {{ _("Upload") }}';
                        }
                    });
                }

                // --- MUSIC DELETION MANAGEMENT ---
                const musicFilesList = document.getElementById('music-files-list');
                if (musicFilesList) {
                    musicFilesList.addEventListener('click', async (event) => {
                        const deleteBtn = event.target.closest('.delete-music-btn');
                        const previewBtn = event.target.closest('.preview-music-btn');

                        if (deleteBtn) {
                            const filename = deleteBtn.dataset.file;
                            if (confirm(`{{ _("Delete this media") }} '${filename}' ?`)) {
                                try {
                                    const response = await fetch(`/api/music_files/${filename}`, { method: 'DELETE' });
                                    const result = await response.json();
                                    if (result.success) {
                                        showToast(result.message);
                                        await loadMusicFiles(); // Rafraîchir les listes partout
                                    } else { alert(result.message); }
                                } catch (e) { alert(i18n.commErrorServer); }
                            }
                        }

                        if (previewBtn) {
                            const filename = previewBtn.dataset.file;
                            toggleMusicPlayback(previewBtn, filename);
                        }
                    });
                }

                // ----- APPROVAL MANAGEMENT (event listeners) -----
                // These listeners use the global functions defined above.
                const grid = document.getElementById('pending-photos-grid');
                if (grid) {
                    grid.addEventListener('click', function (event) {
                        const approveBtn = event.target.closest('.approve-btn');
                        const rejectBtn = event.target.closest('.reject-btn');
                        const filename = event.target.closest('.photo-tile')?.dataset.filename;

                        if (approveBtn && filename) {
                            handlePendingAction(filename, 'approve');
                        } else if (rejectBtn && filename) {
                            handlePendingAction(filename, 'reject');
                        }
                    });
                }

                const refreshBtn = document.getElementById('refresh-pending-btn');
                if (refreshBtn) refreshBtn.addEventListener('click', refreshValidationTab);
            });


        </script>

        <script>
            document.addEventListener("DOMContentLoaded", () => {
                // --- Resolution management ---
                const resolutionSelector = document.getElementById('resolution-selector');
                const applyResolutionBtn = document.getElementById('apply-resolution-btn');
                const resolutionStatus = document.getElementById('resolution-status');

                async function fetchAndPopulateResolutions() {
                    try {
                        const response = await fetch('/api/get_available_resolutions');
                        const data = await response.json();

                        if (data.success && data.resolutions.length > 0) {
                            resolutionSelector.innerHTML = ''; // Vider les options
                            const currentConfigRes = `${document.getElementById('display_width').value}x${document.getElementById('display_height').value}`;

                            data.resolutions.forEach(res => {
                                const option = document.createElement('option');
                                const resValue = `${res.width}x${res.height}`;
                                option.value = resValue;
                                option.textContent = res.text;
                                if (resValue === currentConfigRes) {
                                    option.selected = true;
                                }
                                resolutionSelector.appendChild(option);
                            });
                        } else {
                            resolutionSelector.innerHTML = `<option>${data.message || "{{ _('No resolution found.') }}"}</option>`;
                            applyResolutionBtn.disabled = true;
                        }
                    } catch (error) {
                        resolutionSelector.innerHTML = `<option>{{ _("Loading error.") }}</option>`;
                        applyResolutionBtn.disabled = true;
                    }
                }

                if (applyResolutionBtn) {
                    applyResolutionBtn.addEventListener('click', async () => {
                        const selectedValue = resolutionSelector.value;
                        if (!selectedValue.includes('x')) return;

                        const [width, height] = selectedValue.split('x');

                        resolutionStatus.textContent = "{{ _('Application in progress...') }}";
                        resolutionStatus.className = 'text-sm mt-2 text-blue-600';
                        applyResolutionBtn.disabled = true;

                        try {
                            const response = await fetch('/api/set_resolution', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ width, height })
                            });
                            const result = await response.json();
                            resolutionStatus.textContent = result.message;
                            resolutionStatus.className = result.success ? 'text-sm mt-2 text-green-600' : 'text-sm mt-2 text-red-600';
                            // Update the manual text fields.
                            document.getElementById('display_width').value = width;
                            document.getElementById('display_height').value = height;
                        } catch (error) {
                            resolutionStatus.textContent = "{{ _('Communication error.') }}";
                            resolutionStatus.className = 'text-sm mt-2 text-red-600';
                        } finally {
                            applyResolutionBtn.disabled = false;
                        }
                    });
                }

                // --- Slideshow controls ---
                async function sendSlideshowCommand(command) {
                    try {
                        const response = await fetch(`/api/slideshow/${command}`, { method: 'POST' });
                        const result = await response.json();
                        if (!result.success) {
                            alert(`Erreur: ${result.message}`);
                        }
                        // Update the control state after sending a command.
                        updateSlideshowControlsState();
                    } catch (error) {
                        alert("{{ _('Communication error with the server.') }}");
                    }
                }

                // NEW: Slideshow control management (class-based).
                document.querySelectorAll('.slideshow-control-btn').forEach(btn => {
                    btn.addEventListener('click', () => {
                        const command = btn.dataset.command;
                        if (command) {
                            sendSlideshowCommand(command);
                        }
                    });
                });

                // Notification toggle management.
                document.querySelectorAll('.notification-toggle-btn').forEach(btn => {
                    btn.addEventListener('click', async () => {
                        try {
                            const response = await fetch('/api/slideshow/toggle_notifications', { method: 'POST' });
                            const result = await response.json();
                            if (result.success) {
                                showToast(result.enabled ? "{{ _('Notifications enabled') }}" : "{{ _('Notifications disabled') }}");
                                updateSlideshowControlsState();
                            }
                        } catch (error) {
                            console.error("Erreur toggle notifications:", error);
                        }
                    });
                });

                // NEW: Button to stop the playlist and return to the standard slideshow.
                const stopPlaylistBtn = document.getElementById('stop-playlist-btn');
                if (stopPlaylistBtn) {
                    stopPlaylistBtn.addEventListener('click', async () => {
                        stopPlaylistBtn.disabled = true;
                        stopPlaylistBtn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>{{ _("Reboot...") }}';

                        try {
                            const response = await fetch('/api/slideshow/restart_standard', { method: 'POST' });
                            const result = await response.json();
                            if (result.success) {
                                showToast("{{ _('Standard slideshow restarted.') }}");
                                // Reload the page to ensure all states are correct.
                                setTimeout(() => location.reload(), 1500);
                            } else {
                                alert("{{ _('Error :') }} " + result.message);
                                stopPlaylistBtn.disabled = false;
                                stopPlaylistBtn.innerHTML = '<i class="fas fa-stop-circle mr-2"></i>{{ _("Return to standard slideshow") }}';
                            }
                        } catch (e) {
                            alert("{{ _('Communication error.') }}");
                            stopPlaylistBtn.disabled = false;
                            stopPlaylistBtn.innerHTML = '<i class="fas fa-stop-circle mr-2"></i>{{ _("Return to standard slideshow") }}';
                        }
                    });
                }

                async function updateSlideshowControlsState() {
                    const controlBtns = document.querySelectorAll('.slideshow-control-btn');
                    if (controlBtns.length === 0) return;

                    try {
                        const response = await fetch('/api/slideshow/status');
                        const data = await response.json();
                        const isRunning = data.running;
                        const isPaused = data.paused;

                        // Enable or disable buttons depending on whether the slideshow is running.
                        controlBtns.forEach(btn => {
                            btn.disabled = !isRunning;
                        });

                        // Update the pause/play icon.
                        document.querySelectorAll('.slideshow-pause-icon').forEach(icon => {
                            const btn = icon.closest('button');
                            if (isRunning && isPaused) {
                                icon.classList.remove('fa-pause');
                                icon.classList.add('fa-play');
                                if (btn) btn.classList.add('pulse-animation');
                            } else {
                                icon.classList.remove('fa-play');
                                icon.classList.add('fa-pause');
                                if (btn) btn.classList.remove('pulse-animation');
                            }
                        });

                        // Update the notification button state.
                        const notifEnabled = data.notifications_enabled;
                        document.querySelectorAll('.notification-toggle-btn').forEach(btn => {
                            const icon = btn.querySelector('i');
                            btn.classList.toggle('bg-blue-600', notifEnabled);
                            btn.classList.toggle('bg-gray-400', !notifEnabled);
                            icon.className = notifEnabled ? 'fas fa-bell fa-xs' : 'fas fa-bell-slash fa-xs';
                        });

                        // Manage the visibility of the playlist stop button.
                        const stopPlaylistBtn = document.getElementById('stop-playlist-btn');
                        const noPlaylistIdleBtn = document.getElementById('no-playlist-idle-btn');
                        if (stopPlaylistBtn && noPlaylistIdleBtn) {
                            // Show the stop button only when the slideshow is running AND a playlist is active.
                            if (isRunning && data.is_custom) {
                                stopPlaylistBtn.classList.remove('hidden');
                                noPlaylistIdleBtn.classList.add('hidden');
                            } else {
                                stopPlaylistBtn.classList.add('hidden');
                                noPlaylistIdleBtn.classList.remove('hidden');
                            }
                        }

                    } catch (error) {
                        console.error("Impossible de récupérer l'état du diaporama:", error);
                    }
                }

                fetchAndPopulateResolutions(); // Charger les résolutions au démarrage
                setInterval(updateSlideshowControlsState, 5000); // Mettre à jour l'état des boutons
                updateSlideshowControlsState(); // Appel initial

                // --- Resolution detection ---
                const detectResBtn = document.getElementById("detect-resolution-btn");

                // Only run this logic if the button exists (i.e., the 'tab-affichage' tab is loaded).
                if (detectResBtn) {
                    async function fetchAndSetResolution() {
                        const originalTooltip = detectResBtn.title;
                        const originalText = detectResBtn.innerHTML;
                        detectResBtn.innerHTML = "{{ _('Detection...') }}";
                        detectResBtn.disabled = true;

                        try {
                            const response = await fetch('/get_current_resolution');
                            const data = await response.json();

                            if (data.success) {
                                document.getElementById('display_width').value = data.width;
                                document.getElementById('display_height').value = data.height;
                                detectResBtn.innerHTML = "{{ _('Detected!') }}";
                                detectResBtn.title = `Détecté : ${data.width}x${data.height}`;
                            } else {
                                detectResBtn.innerHTML = "{{ _('Failure') }}";
                                detectResBtn.title = data.message || "{{ _('Error during detection.') }}";
                                detectResBtn.innerHTML = originalText;
                            }
                        } catch (error) {
                            detectResBtn.title = "{{ _('Communication error with the server.') }}";
                            detectResBtn.innerHTML = originalText;
                        } finally {
                            setTimeout(() => {
                                detectResBtn.innerHTML = originalText;
                                detectResBtn.disabled = false;
                                detectResBtn.title = originalTooltip;
                            }, 2000);
                        }
                    }

                    detectResBtn.addEventListener("click", fetchAndSetResolution);
                }

                // --- Live preview ---
                const livePreviewImage = document.getElementById('live-preview-image');
                const livePreviewStatus = document.getElementById('live-preview-status');
                let diskUsageChart; // NOUVEAU: pour le graphique d'utilisation Disque

                // Function to create or update the disk usage chart.
                function updateDiskUsageChart(historyData) {
                    const ctx = document.getElementById('diskUsageChart').getContext('2d');
                    if (!ctx) return;

                    const labels = historyData.map(d => d.time);
                    const usages = historyData.map(d => d.usage);

                    if (diskUsageChart) {
                        // Update an existing chart.
                        diskUsageChart.data.labels = labels;
                        diskUsageChart.data.datasets[0].data = usages;
                        diskUsageChart.update();
                    } else {
                        // Create a new chart.
                        diskUsageChart = new Chart(ctx, {
                            type: 'line',
                            data: {
                                labels: labels,
