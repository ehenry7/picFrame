                                const option = document.createElement('option');
                                option.value = file;
                                option.textContent = file;
                                newPlaylistMusicSelect.appendChild(option);
                            });
                        }

                        // 2. Populate the management list (Actions).
                        const listContainer = document.getElementById('music-files-list');
                        if (listContainer) {
                            if (availableMusicFiles.length === 0) {
                                listContainer.innerHTML = `<p class="text-sm text-gray-500 italic col-span-full">${i18n.noMusicSelected}</p>`;
                            } else {
                                listContainer.innerHTML = availableMusicFiles.map(file => `
                                    <div class="flex items-center justify-between bg-white p-2 rounded shadow-sm border border-gray-200">
                                        <div class="flex items-center gap-2 overflow-hidden">
                                            <i class="fas fa-music text-purple-500 text-xs"></i>
                                            <span class="text-xs truncate font-mono" title="${file}">${file}</span>
                                        </div>
                                        <div class="flex items-center gap-1">
                                            <button type="button" class="preview-music-btn text-blue-500 hover:text-blue-700 p-1 w-6 h-6 flex items-center justify-center" data-file="${file}" title="${i18n.listenToMusic}">
                                                <i class="fas fa-play fa-fw text-xs"></i>
                                            </button>
                                            <button type="button" class="delete-music-btn text-red-500 hover:text-red-700 p-1" data-file="${file}" title="${i18n.deletePlaylist}">
                                                <i class="fas fa-trash-alt text-xs"></i>
                                            </button>
                                        </div>
                                    </div>
                                `).join('');
                            }
                        }
                    } else { console.error("Error loading music files:", data.message); }
                } catch (error) { console.error("Communication error loading music files:", error); }
            }

            let currentAudioPlayer = null;
            let currentPlayingButton = null;

            function resetPlayButton(button) {
                if (button) {
                    const icon = button.querySelector('i');
                    if (icon) {
                        icon.classList.remove('fa-stop');
                        icon.classList.add('fa-play');
                    }
                    button.title = i18n.listenToMusic;
                }
            }

            function toggleMusicPlayback(button, musicFile) {
                const musicUrl = `/static/music/${musicFile}`;
                const absoluteMusicUrl = new URL(musicUrl, window.location.origin).href;

                if (currentAudioPlayer && currentAudioPlayer.src !== absoluteMusicUrl) {
                    currentAudioPlayer.pause();
                    currentAudioPlayer.currentTime = 0;
                    resetPlayButton(currentPlayingButton);
                }

                if (currentAudioPlayer && currentAudioPlayer.src === absoluteMusicUrl && !currentAudioPlayer.paused) {
                    currentAudioPlayer.pause();
                    currentAudioPlayer.currentTime = 0;
                    resetPlayButton(button);
                    currentAudioPlayer = null;
                    currentPlayingButton = null;
                } else {
                    if (!currentAudioPlayer || currentAudioPlayer.src !== absoluteMusicUrl) {
                        currentAudioPlayer = new Audio(musicUrl);
                        currentAudioPlayer.volume = 0.7;
                        currentAudioPlayer.addEventListener('ended', () => {
                            resetPlayButton(button);
                            currentAudioPlayer = null;
                            currentPlayingButton = null;
                        });
                    }
                    currentAudioPlayer.play();
                    const icon = button.querySelector('i');
                    if (icon) {
                        icon.classList.remove('fa-play');
                        icon.classList.add('fa-stop');
                    }
                    button.title = i18n.stopMusic;
                    currentPlayingButton = button;
                }
            }

