                <!-- NEW SMART PLUG SECTION -->
                <fieldset class="mt-6">
                    <legend>
                        <h3><i class="fas fa-plug mr-2"></i>{{ _("Power management (Connected Socket)") }}</h3>
                    </legend>
                    <p class="text-sm text-gray-600 mb-3">{{ _("If your screen does not go to sleep completely, you can use a connected outlet (Wi-Fi) to turn off its power. PictureFrame will send a simple HTTP request to the URLs you specify.") }}<br>
                    <strong>{{ _("Examples of URLs:") }}</strong>
                    <ul class="list-disc list-inside text-xs text-gray-500 mt-1">
                        <li><strong>Tasmota:</strong> `http://IP_PRISE/cm?cmnd=Power%20On`</li>
                        <li><strong>Home Assistant (Webhook):</strong> `http://IP_HA:8123/api/webhook/pictureframe_on`</li>
                        <li><strong>Shelly:</strong> `http://IP_PRISE/relay/0?turn=on`</li>
                        <li><strong>Kasa (via passerelle):</strong> `http://IP_PASSERELLE:PORT/on`</li>
