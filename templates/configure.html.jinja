                                document.getElementById('update-commit').textContent = data.commit || '';
                                document.getElementById('update-current-version').textContent = data.current_version || '';
                                if (data.has_updates) {
                                    available.classList.remove('hidden');
                                    document.getElementById('update-available-text').textContent =
                                        data.behind_count + ' ' + (data.behind_count === 1 ? {{ _("new update available") | tojson }} : {{ _("new updates available") | tojson }});
                                    const list = document.getElementById('update-commits-list');
                                    list.innerHTML = '';
                                    (data.new_commits || []).forEach(line => {
                                        const li = document.createElement('li');
                                        li.textContent = line;
                                        list.appendChild(li);
                                    });
                                } else {
                                    upToDate.classList.remove('hidden');
                                }
                                if (data.backup_exists) {
                                    backupSection.classList.remove('hidden');
                                }
                            })
                            .catch(err => {
                                loading.classList.add('hidden');
                                notGit.classList.remove('hidden');
                                notGit.querySelector('p').textContent = {{ _("Error checking git repository.") | tojson }} + ' ' + err;
                            });
                    }

                    const confirmUpdate = {{ _("Do you really want to update the application? The server will restart. Make sure no system update is in progress.") | tojson }};
                    const confirmRevert = {{ _("Do you want to restore the previous version? The application will restart.") | tojson }};
                    const confirmDeleteBackup = {{ _("Do you want to delete the previous version backup? This action is irreversible.") | tojson }};
                    const msgStartingUpdate = {{ _("Starting update...") | tojson }};
                    const msgRedirecting = {{ _("Server will restart momentarily.") | tojson }};
                    const msgError = {{ _("Error") | tojson }};
                    const msgCommError = {{ _("Communication error with the server.") | tojson }};
                    const msgCommErrorShort = {{ _("Communication error.") | tojson }};
                    const msgRestoring = {{ _("Restoring...") | tojson }};

                    // Refresh button — re-checks git status without full page reload.
                    const refreshBtn = document.getElementById('refresh-update-status-btn');
                    refreshBtn.addEventListener('click', () => {
                        refreshBtn.disabled = true;
                        refreshBtn.querySelector('i').classList.add('fa-spin');
                        // Reset status messages only (keep git info line visible).
                        available.classList.add('hidden');
                        upToDate.classList.add('hidden');
                        backupSection.classList.add('hidden');
                        resultDiv.innerHTML = '';
                        loadUpdateStatus();
                        // Re-enable after loadUpdateStatus completes (it's async).
                        setTimeout(() => {
                            refreshBtn.disabled = false;
                            refreshBtn.querySelector('i').classList.remove('fa-spin');
                        }, 3000);
                    });

                    updateBtn.addEventListener('click', () => {
                        if (!confirm(confirmUpdate)) return;
                        updateBtn.disabled = true;
                        // Show the waiting overlay IMMEDIATELY — the server may
                        // exit before the fetch response arrives.
                        window.__waitForServerRestart('{{ APP_INSTANCE_ID }}', {{ _("Updating...") | tojson }});
                        fetch('/api/trigger_update', { method: 'POST' })
                            .then(r => {
                                if (!r.ok) throw new Error('server down');
                                return r.json();
                            })
                            .then(data => {
                                // Only hide overlay if the server explicitly
                                // refused the update (e.g. not a git repo).
                                if (!data.success) {
                                    document.getElementById('update-overlay').classList.add('hidden');
                                    showResult(data.message || msgError, true);
                                    updateBtn.disabled = false;
                                }
                            })
                            .catch(() => {
                                // Expected — the server is shutting down.
                            });
                    });

                    revertBtn.addEventListener('click', () => {
                        if (!confirm(confirmRevert)) return;
                        revertBtn.disabled = true;
                        // Show the waiting overlay IMMEDIATELY.
                        window.__waitForServerRestart('{{ APP_INSTANCE_ID }}', {{ _("Restoring...") | tojson }});
                        fetch('/api/revert_to_backup', { method: 'POST' })
                            .then(r => {
                                if (!r.ok) throw new Error('server down');
                                return r.json();
                            })
                            .then(data => {
                                if (!data.success) {
                                    document.getElementById('update-overlay').classList.add('hidden');
                                    showResult(data.message || msgError, true);
                                    revertBtn.disabled = false;
                                }
                            })
                            .catch(() => {
                                // Expected — the server is shutting down.
                            });
                    });

                    deleteBtn.addEventListener('click', () => {
                        if (!confirm(confirmDeleteBackup)) return;
                        deleteBtn.disabled = true;
                        fetch('/api/delete_backup', { method: 'POST' })
                            .then(r => r.json())
                            .then(data => {
                                if (data.success) {
                                    backupSection.classList.add('hidden');
                                    showResult(data.message, false);
                                } else {
                                    showResult(data.message || msgError, true);
                                    deleteBtn.disabled = false;
                                }
                            })
                            .catch(() => {
                                showResult(msgCommErrorShort, true);
                                deleteBtn.disabled = false;
                            });
                    });

                    loadUpdateStatus();
                })();

                // ----- EXPAND FILESYSTEM -----
                document.getElementById("expand-fs-btn").addEventListener("click", () => {
                    if (!confirm("{{ _('This operation will prepare the system to extend the partition to the next restart. Do you want to continue?') }}")) {
                        return;
                    }

                    const btn = document.getElementById("expand-fs-btn");
                    const statusDiv = document.getElementById("expand-fs-status");
                    const allActionButtons = document.querySelectorAll('.import-button, .system-button, #scan-wifi-btn, #toggle-eth0-btn, #clear-logs-btn, #expand-fs-btn');

                    statusDiv.innerHTML = ""; // Clear previous messages

                    function disableAllButtons() {
                        allActionButtons.forEach(b => { b.disabled = true; b.classList.add("opacity-50", "cursor-not-allowed"); });
                    }

                    function enableAllButtons() {
                        allActionButtons.forEach(b => { b.disabled = false; b.classList.remove("opacity-50", "cursor-not-allowed"); });
                    }

                    disableAllButtons();

                    fetch('/api/expand_filesystem', { method: 'POST' })
                        .then(response => {
                            const reader = response.body.getReader();
                            const decoder = new TextDecoder();

                            function processStream() {
                                reader.read().then(({ done, value }) => {
                                    if (done) {
                                        enableAllButtons();
                                        return;
                                    }

                                    const chunk = decoder.decode(value, { stream: true });
                                    const lines = chunk.split('\n\n');

                                    lines.forEach(line => {
                                        if (line.startsWith('data: ')) {
                                            try {
                                                const data = JSON.parse(line.substring(6));
                                                displayMessage(statusDiv, data.message, data.type.toLowerCase());
                                            } catch (e) { console.error("Erreur parsing JSON:", e, "Ligne:", line); }
                                        }
                                    });
                                    processStream();
                                });
                            }
                            processStream();
                        })
                        .catch(error => {
                            displayMessage(statusDiv, `Erreur de communication: ${error}`, 'error');
                            enableAllButtons();
                        });
                });
            });

        </script>

    <!-- Inline update/restart overlay — shown when the app exits for an update.
         Polls /api/ping until the server is back with a new instance ID. -->
    <div id="update-overlay" class="hidden fixed inset-0 z-50 flex items-start justify-center pt-12"
         style="background: rgba(0,0,0,0.7); backdrop-filter: blur(4px);">
        <div class="text-center text-white p-6 rounded-2xl max-w-md"
             style="background: rgba(255,255,255,0.1);">
            <img src="{{ url_for('static', filename='pictureframe_logo.svg') }}" alt="PictureFrame"
                 style="width: 100px; margin: 0 auto 16px;">
            <h2 class="text-xl font-semibold mb-3" id="update-overlay-title">{{ _("Updating...") }}</h2>
            <div class="spinner" style="width: 40px; height: 40px; margin: 0 auto 16px;
                 border: 4px solid rgba(255,255,255,0.3); border-top: 4px solid white;
                 border-radius: 50%; animation: spin 1s linear infinite;"></div>
            <style>@keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }</style>
            <p id="update-overlay-status" class="text-sm opacity-90 mb-2">{{ _("The server is restarting. Please wait...") }}</p>
            <p id="update-overlay-countdown" class="text-2xl font-bold font-mono"></p>
        </div>
    </div>

    <script>
        (function() {
            const overlay = document.getElementById('update-overlay');
            const overlayTitle = document.getElementById('update-overlay-title');
            const overlayStatus = document.getElementById('update-overlay-status');
            const overlayCountdown = document.getElementById('update-overlay-countdown');

            /**
             * Show the update overlay and poll /api/ping until the server
             * comes back with a new instance ID, then redirect to /configure.
             * @param {string} oldInstanceId - The instance ID before the update.
             * @param {string} title - Overlay title text.
             */
            window.__waitForServerRestart = function(oldInstanceId, title) {
                overlayTitle.textContent = title;
                overlay.classList.remove('hidden');

                let remaining = 90;
                const countdownInterval = setInterval(() => {
                    remaining--;
                    overlayCountdown.textContent = remaining > 0 ? remaining + 's' : '⏳';
                }, 1000);

                // Wait 15s before first poll — gives the old server time to
                // shut down so we don't falsely detect it as "back online".
                let consecutiveHits = 0;
                let startedPolling = false;

                setTimeout(() => {
                    startedPolling = true;
                    const checkInterval = setInterval(async () => {
                        try {
                            const resp = await fetch('/api/ping', { cache: 'no-cache' });
                            if (!resp.ok) throw new Error('not ok');
                            const data = await resp.json();

                            // Server responded — check if it's a new instance.
                            if (!oldInstanceId || (data.instance && data.instance !== oldInstanceId)) {
                                consecutiveHits++;
                                if (consecutiveHits >= 3) {
                                    // Require 3 consecutive hits to avoid a
                                    // transient response during shutdown.
                                    clearInterval(checkInterval);
                                    clearInterval(countdownInterval);
                                    overlayStatus.textContent = {{ _("Server is back online! Redirecting...") | tojson }};
                                    overlayCountdown.textContent = '✅';
                                    setTimeout(() => { window.location.href = '/configure'; }, 1500);
                                } else {
                                    overlayStatus.textContent = {{ _("Server is responding, verifying...") | tojson }};
                                }
                            } else {
                                consecutiveHits = 0;
                                overlayStatus.textContent = {{ _("Server is starting up...") | tojson }};
                            }
                        } catch (e) {
                            consecutiveHits = 0;
                            // Server is still down — expected during update.
                            overlayStatus.textContent = {{ _("Waiting for the server to come back...") | tojson }};
                        }
                    }, 3000);

                    // Safety: after 120s, stop polling and show a manual link.
                    setTimeout(() => {
                        if (overlay.classList.contains('hidden')) return;
                        clearInterval(checkInterval);
                        clearInterval(countdownInterval);
                        overlayStatus.innerHTML = {{ _("The server is taking longer than expected. ") | tojson }}
                            + '<a href="/configure" class="underline text-blue-300">' + {{ _("Click here to retry.") | tojson }} + '</a>';
                        overlayCountdown.textContent = '';
                    }, 120000);
                }, 8000);
            };
        })();
    </script>
</body>
