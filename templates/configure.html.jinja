                        resultDiv.innerHTML = '<p class="text-sm ' + (isError ? 'text-red-600' : 'text-green-600') + '">' + msg + '</p>';
                    }

                    function loadUpdateStatus() {
                        fetch('/api/update_status')
                            .then(r => {
