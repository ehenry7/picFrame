            async function checkPlugStatus() {
                if (!plugCheckbox.checked || !statusIndicator) {
                    statusIndicator.classList.add('hidden');
                    return;
                }
                statusIndicator.classList.remove('hidden');

                try {
                    const response = await fetch('/api/smart_plug/status');
                    const data = await response.json();

                    if (data.status === 'on') {
                        statusLight.className = 'w-4 h-4 rounded-full bg-green-500';
                        statusText.textContent = "{{ _('Outlet Status: On') }}";
                    } else if (data.status === 'off') {
                        statusLight.className = 'w-4 h-4 rounded-full bg-red-500';
                        statusText.textContent = "{{ _('Outlet Status: Off') }}";
                    } else if (data.status === 'disabled') {
                        statusIndicator.classList.add('hidden'); // Cacher si non configuré
                    } else { // error, unknown, unavailable...
