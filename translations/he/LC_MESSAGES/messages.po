#: app.py:611
msgid "Code d'invitation invalide."
msgstr "קוד הזמנה לא חוקי."

#: app.py:617
msgid "Ce code d'invitation a expiré."
msgstr "קוד הזמנה זה פג תוקפו."

#: app.py:623
msgid "Vous êtes déjà autorisé. Envoyez-moi une photo !"
msgstr "כבר קיבלת אישור. שלח לי תמונה!"

#: app.py:625
msgid "Ce code d'invitation a déjà été utilisé."
msgstr "קוד הזמנה זה כבר נוצל."

#: app.py:636
#, python-format
msgid ""
"Félicitations %(name)s ! Vous pouvez maintenant envoyer des cartes postales "
"au cadre."
msgstr "מזל טוב %(name)s! כעת ניתן לשלוח גלויות למסגרת."

#: app.py:664
#, python-format
msgid "L'accès pour l'invité '%(name)s' a été révoqué."
msgstr "הגישה עבור האורח '%(name)s' בוטלה."

#: app.py:707 app.py:712
msgid "Aucun fichier sélectionné."
msgstr "& יצירת תעודה"

#: app.py:730
#, python-format
msgid "%(count)s photo(s) envoyée(s) pour validation avec succès !"
msgstr "תמונה/ות %(count)s הוגשו בהצלחה לאימות!"

#: app.py:789
msgid "Photo rejetée."
msgstr "התמונה נדחתה."

#: app.py:832
msgid "Photo approuvée et préparée. Le diaporama a été mis à jour."
msgstr "התמונה אושרה והוכנה. מצגת השקופיות עודכנה."

#: app.py:834
msgid "La préparation de la photo a échoué. La photo reste en attente."
msgstr "הכנת התמונה נכשלה. התמונה עדיין ממתינה."

#: app.py:838
msgid "Action inconnue."
msgstr "פעולה לא ידועה."

#: app.py:860
msgid "Connexion réussie"
msgstr "הכניסה למערכת אושרה"

#: app.py:863
msgid "Identifiants invalides"
msgstr "אישורים לא חוקיים"

#: app.py:869
msgid "Déconnexion réussie"
msgstr "היציאה הצליחה"

#: app.py:1075
msgid ""
"Configuration enregistrée. Le diaporama a été relancé pour appliquer les "
"changements."
msgstr "התצורה נשמרה. מצגת השקופיות הופעלה מחדש כדי להחיל את השינויים."

#: app.py:1501
msgid "Le token du bot est requis."
msgstr "נדרש טוקן הבוט."

#: app.py:1511
#, python-format
msgid "Token valide ! Le bot s'appelle '%(bot_name)s'."
msgstr "אסימון תקף! שם הבוט הוא '%(bot_name)s'."

#: app.py:1514
#, python-format
msgid "Échec de l'envoi : %(error)s"
msgstr "השליחה נכשלה: %(error)s"

#: app.py:1516
#, python-format
msgid "Erreur de connexion : %(error)s"
msgstr "שגיאת חיבור: %(error)s"

#: app.py:1901
msgid "Lancement de l'import..."
msgstr "מתחיל ייבוא..."

#: app.py:2230
msgid ""
"L'application web redémarre... La page sera inaccessible pendant quelques "
"instants."
msgstr "אפליקציית האינטרנט מופעלת מחדש... הדף לא יהיה זמין למשך מספר רגעים."

#: app.py:2861
#, python-format
msgid ""
"Résolution appliquée : %(width)sx%(height)s. Le diaporama a été redémarré."
msgstr "הרזולוציה הוחלה: %(width)sx%(height)s. המצגת הופעלה מחדש."

#: app.py:2863
#, python-format
msgid ""
"Résolution appliquée : %(width)sx%(height)s. Le diaporama n'était pas en "
"cours."
msgstr "הרזולוציה הוחלה: %(width)sx%(height)s. המצגת לא הייתה פעילה."

#: app.py:2948
msgid "Le SSID et le pays Wi-Fi sont obligatoires."
msgstr "שם הרשת (SSID) ומדינת ה-Wi-Fi הם שדות חובה."

#: app.py:2961
msgid ""
"Paramètres Wi-Fi appliqués. Le service réseau a été redémarré pour forcer la"
" connexion. Veuillez patienter une minute et vérifier le statut."
msgstr ""
"הגדרות ה-Wi-Fi הוחלו. שירות הרשת הופעל מחדש כדי לאלץ חיבור. אנא המתן דקה "
"ובדוק את הסטטוס."

#: app.py:2963
#, python-format
msgid "Erreur lors de l'application des paramètres Wi-Fi : %(error)s"
msgstr "שגיאה בהחלת הגדרות ה-Wi-Fi: %(error)s"

#: app.py:3019
msgid "Les deux champs de mot de passe sont requis."
msgstr "נדרשים שני שדות הסיסמה."

#: app.py:3023
msgid "Les mots de passe ne correspondent pas."
msgstr "הסיסמאות אינן תואמות."

#: app.py:3027
msgid "Le mot de passe doit contenir au moins 6 caractères."
msgstr "הסיסמה חייבת להכיל לפחות 6 תווים."

#: app.py:3032
msgid ""
"Mot de passe mis à jour avec succès. Il sera nécessaire pour votre prochaine"
" connexion."
msgstr "הסיסמה עודכנה בהצלחה. היא תידרש בהתחברות הבאה שלך."

#: app.py:3034
#, python-format
msgid "Erreur lors du changement de mot de passe : %(error)s"
msgstr "שגיאה בשינוי הסיסמה: %(error)s"

#: app.py:3078
msgid "Le fichier de configuration n'a pas été trouvé."
msgstr "קובץ התצורה לא נמצא."

#: app.py:3086 app.py:3091
msgid "Aucun fichier de sauvegarde sélectionné."
msgstr "לא נבחר קובץ גיבוי."

#: app.py:3101
msgid ""
"Configuration restaurée avec succès ! Le diaporama va redémarrer pour "
"appliquer les changements."
msgstr "התצורה שוחזרה בהצלחה! המצגת תופעל מחדש כדי להחיל את השינויים."

#: app.py:3103
msgid ""
"Fichier de sauvegarde invalide ou corrompu. Ce n'est pas un fichier JSON "
"valide."
msgstr "קובץ גיבוי לא תקין או פגום. זהו אינו קובץ JSON תקין."

#: app.py:3105
#, python-format
msgid "Erreur lors de la restauration : %(error)s"
msgstr "שגיאה בשחזור: %(error)s"

#: app.py:3206
msgid "name_key"
msgstr ""

