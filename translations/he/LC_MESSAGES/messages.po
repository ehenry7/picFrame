#: local_slideshow.py:1126
#, python-format
msgid "(Anniversaire) Il y a %(num)d an"
msgstr "(יום שנה) לפני שנה %(num)d"

#: local_slideshow.py:1126
#, python-format
msgid "(Anniversaire) Il y a %(num)d ans"
msgstr "(יום שנה) לפני %(num)d שנים"

#: local_slideshow.py:2134
msgid "Aucune photo trouvée."
msgstr "לא נמצאו תמונות."

#: local_slideshow.py:2135
#, python-format
msgid "Configurez sur : http://%(ip)s"
msgstr "הגדר בכתובת: http://%(ip)s"

#: local_slideshow.py:2136
msgid "(Identifiants dans credentials.json à la racine de la SD)"
msgstr "(פרטי התחברות ב-credentials.json בתיקיית השורש של כרטיס ה-SD)"

#: local_slideshow.py:2137
#, python-format
msgid "Résolution de l'écran : [%(w)s x %(h)s]"
